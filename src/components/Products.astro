---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import ActionButton from './design-system/ActionButton.astro';

const { products } = siteLabels;
---

<SectionBlock id="products" className="products-showcase" tone="none">
  <div class="products-showcase__intro container">
    <p class="section-label">{products.sectionLabel}</p>
    <h2 class="products-showcase__title">{products.sectionTitle}</h2>
    <p class="products-showcase__description">{products.sectionDescription}</p>
  </div>

  {products.items.map((product, index) => (
    <article
      class:list={['product-feature', index % 2 === 1 && 'product-feature--flip']}
      id={product.id}
      style={`--product-accent: ${product.color};`}
    >
      <div class="product-feature__inner container">
        <div class="product-feature__copy">
          <p class="product-feature__eyebrow">
            <span>{product.eyebrow}</span>
            {product.status && <span class="product-feature__status">{product.status}</span>}
          </p>
          <div class="product-feature__heading">
            <img src={product.markSrc} width="48" height="48" alt="" />
            <h3>{product.title}</h3>
          </div>
          <p class="product-feature__category">{product.category}</p>
          <p class="product-feature__description">{product.description}</p>
          <ul class="product-feature__points">
            {product.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
          <ActionButton
            href={product.href}
            label={product.hrefLabel}
            variant="outline"
            external={true}
            className="product-feature__cta ds-action-button--outline-dark"
          />
        </div>
        <a
          class="product-feature__media"
          href={product.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={product.hrefLabel}
        >
          <span class="product-feature__browser" aria-hidden="true">
            <i></i><i></i><i></i>
            <span class="product-feature__url">{product.href.replace(/^https?:\/\//, '')}</span>
          </span>
          <img
            src={product.imageSrc}
            alt={product.imageAlt}
            width="1288"
            height="1120"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </article>
  ))}
</SectionBlock>

<style>
  :global(.products-showcase) {
    background: var(--surface-base);
    color: var(--bg-dark);
    padding-bottom: 0 !important;
  }

  .products-showcase__intro {
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .products-showcase__title {
    max-width: 16ch;
    margin: 0 0 18px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .products-showcase__description {
    max-width: 38rem;
    margin: 0;
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .product-feature {
    border-top: 1px solid var(--border-on-light);
    padding: clamp(56px, 7vw, 96px) 0;
  }

  .product-feature__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .product-feature--flip .product-feature__copy {
    order: 2;
  }

  .product-feature__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    color: var(--product-accent);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .product-feature__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .product-feature__status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .product-feature__heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }

  .product-feature__heading img {
    flex-shrink: 0;
    border-radius: 12px;
    box-shadow: 0 6px 16px rgba(11, 16, 13, 0.14);
  }

  .product-feature__heading h3 {
    margin: 0;
    font-size: clamp(2.1rem, 1.4rem + 2.4vw, 3rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .product-feature__category {
    margin: 0 0 20px;
    color: var(--text-muted);
    font-size: var(--fs-h5);
    line-height: 1.35;
  }

  .product-feature__description {
    margin: 0 0 24px;
    line-height: 1.6;
    max-width: 34rem;
  }

  .product-feature__points {
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .product-feature__points li {
    position: relative;
    padding-left: 22px;
    line-height: 1.45;
    font-size: var(--fs-body);
  }

  .product-feature__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 2px;
    background: var(--product-accent);
  }

  .product-feature__media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border-on-light);
    background: #fff;
    box-shadow: var(--shadow-float);
    transition: transform 240ms ease, box-shadow 240ms ease;
  }

  .product-feature__media:hover,
  .product-feature__media:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 28px 48px rgba(11, 16, 13, 0.16);
  }

  .product-feature__browser {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    background: var(--surface-subtle);
    border-bottom: 1px solid var(--border-on-light);
  }

  .product-feature__browser i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(11, 16, 13, 0.18);
  }

  .product-feature__url {
    margin-left: 10px;
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.7);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-feature__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 1288 / 1120;
    object-fit: cover;
    object-position: top center;
  }

  @media (max-width: 900px) {
    .product-feature__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .product-feature--flip .product-feature__copy {
      order: 0;
    }

    .product-feature__media img {
      aspect-ratio: 4 / 3;
    }

    .product-feature__cta {
      width: 100%;
    }
  }
</style>
