---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import CaseStudyCard from './design-system/CaseStudyCard.astro';

const { products } = siteLabels;
const leftProducts = products.items.filter((_, index) => index % 2 === 0);
const rightProducts = products.items.filter((_, index) => index % 2 === 1);
---

<SectionBlock id="products" className="case-studies">
  <div class="case-studies__inner container">
    <div class="case-studies__intro" data-case-reveal style="--reveal-delay: 100ms">
      <h2 class="case-studies__title">{products.sectionTitle}</h2>
      <p class="case-studies__description">{products.sectionDescription}</p>
    </div>
    <div class="case-studies__masonry">
      <div class="case-studies__column case-studies__column--left">
        {leftProducts.map((product, index) => (
          <div data-case-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <CaseStudyCard
              title={product.title}
              category={product.category}
              description={product.description}
              color={product.color}
              imageSrc={product.imageSrc}
              imageAlt={product.imageAlt}
              href={product.href}
              external={true}
              className="case-studies__card case-studies__card--left"
            />
          </div>
        ))}
      </div>
      <div class="case-studies__column case-studies__column--right">
        {rightProducts.map((product, index) => (
          <div data-case-reveal style={`--reveal-delay: ${120 + index * 80}ms`}>
            <CaseStudyCard
              title={product.title}
              category={product.category}
              description={product.description}
              color={product.color}
              imageSrc={product.imageSrc}
              imageAlt={product.imageAlt}
              href={product.href}
              external={true}
              className="case-studies__card case-studies__card--right"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</SectionBlock>

<style>
  .case-studies__masonry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .case-studies__column {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* Stagger the right column like the template's masonry. */
  .case-studies__column--right {
    padding-top: 72px;
  }

  .case-studies__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .case-studies__intro {
    max-width: 470px;
    margin: 0 auto;
    text-align: center;
  }

  .case-studies__title {
    color: var(--bg-dark);
    margin-bottom: 12px;
  }

  .case-studies__description {
    line-height: 1.45;
    color: var(--bg-dark);
  }

  .case-studies__column :global(.case-studies__card) {
    border-radius: 0;
  }

  .case-studies__column :global(.case-studies__card .ds-case-card__image) {
    aspect-ratio: 161 / 140;
  }

  @media (max-width: 1024px) {
    .case-studies__column {
      gap: 24px;
    }

    .case-studies__column--right {
      padding-top: 48px;
    }

    .case-studies__intro {
      margin-bottom: 4px;
    }
  }

  @media (max-width: 768px) {
    .case-studies__masonry {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .case-studies__column--right {
      padding-top: 0;
    }

    .case-studies__intro {
      text-align: center;
      max-width: 100%;
    }
  }

  /* Reveal animation */
  :global([data-case-reveal].is-observing:not(.is-visible)) {
    opacity: 0;
    transform: translateY(48px) scale(0.985);
    filter: blur(8px);
  }

  :global([data-case-reveal].is-observing) {
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 700ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: transform, opacity, filter;
  }

  :global([data-case-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-case-reveal].is-observing) {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>

<script>
  import { useVisibilityClass } from '../scripts/hooks/useVisibilityClass.js';
  useVisibilityClass({
    selector: '[data-case-reveal]',
    threshold: 0.05,
    rootMargin: '0px',
    once: true,
    revealIfAlreadyVisible: false,
  });
</script>
