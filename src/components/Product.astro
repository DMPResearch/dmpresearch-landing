---
import type { Product } from '../content/site';

interface Props {
  product: Product;
  layout: 'wide' | 'split';
}

const { product, layout } = Astro.props;
const { id, index, name, tint, mark, image, imageAlt, title, text, points, link, facts } = product;
---

<section
  class:list={['product', 'section', `product--${layout}`, `product--${tint}`]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="product__inner container">
    <header class="product__head" data-reveal>
      <p class="product__meta">
        <span class="mono">{index}</span>
        <span class="product__name">
          <img src={mark} width="28" height="28" alt="" />
          {name}
        </span>
      </p>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="lede product__text">{text}</p>
      <ul class="product__points">
        {points.map((point) => <li>{point}</li>)}
      </ul>
      <a class="btn btn--ghost product__cta" href={link.href} target="_blank" rel="noopener">
        {link.label}
        <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
    </header>

    <figure class:list={['frame', `frame--${tint}`, 'product__frame']} data-reveal style="--delay: 120ms">
      <div class="frame__glow" aria-hidden="true"></div>
      <div class="frame__window">
        <div class="product__chrome" aria-hidden="true">
          <i></i><i></i><i></i>
          <span>{link.href.replace(/^https?:\/\//, '')}</span>
        </div>
        <img src={image} width="1288" height="1120" alt={imageAlt} loading="lazy" decoding="async" />
      </div>
    </figure>

    <dl class="product__facts" data-reveal style="--delay: 200ms">
      {facts.map((fact) => (
        <div class="product__fact">
          <dt class="mono">{fact.term}</dt>
          <dd>{fact.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .product {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .product::before {
    content: '';
    position: absolute;
    inset: 10% auto auto 50%;
    width: min(680px, 80vw);
    height: 280px;
    transform: translateX(-50%);
    pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--tint, var(--teal)) 35%, transparent), transparent 70%);
    filter: blur(20px);
    opacity: 0.55;
  }

  .product--blue {
    --tint: var(--blue);
  }

  .product--olive {
    --tint: var(--olive);
  }

  .product__inner {
    position: relative;
    display: grid;
    gap: var(--s-7);
  }

  .product__head {
    display: grid;
    gap: var(--s-4);
    max-width: 640px;
  }

  .product__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
  }

  .product__name {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .product__name img {
    border-radius: 8px;
  }

  .product__points {
    display: grid;
    gap: 10px;
    margin-top: 4px;
  }

  .product__points li {
    position: relative;
    padding-left: 18px;
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  .product__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tint, var(--teal));
    box-shadow: 0 0 12px color-mix(in srgb, var(--tint, var(--teal)) 60%, transparent);
  }

  .product__cta {
    justify-self: start;
    margin-top: 8px;
  }

  .product__chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
  }

  .product__chrome i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(238, 243, 236, 0.22);
  }

  .product__chrome i:nth-child(1) {
    background: #ff5f57;
  }
  .product__chrome i:nth-child(2) {
    background: #febc2e;
  }
  .product__chrome i:nth-child(3) {
    background: #28c840;
  }

  .product__chrome span {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-3);
  }

  .product__frame .frame__window {
    aspect-ratio: 16 / 10;
  }

  .product__frame .frame__window img {
    aspect-ratio: 16 / 10;
  }

  .product__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--s-5);
  }

  .product__fact {
    display: grid;
    gap: var(--s-1);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .product__fact dd {
    font-size: var(--t-small);
    font-weight: 550;
  }

  @media (min-width: 900px) {
    .product--wide .product__frame .frame__window,
    .product--wide .product__frame .frame__window img {
      aspect-ratio: 21 / 10;
    }

    .product--wide .product__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 760px;
    }

    .product--split .product__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'frame head'
        'frame facts';
      column-gap: clamp(40px, 6vw, 88px);
      row-gap: var(--s-7);
      align-items: start;
    }

    .product--split .product__head {
      grid-area: head;
      align-self: end;
    }

    .product--split .product__frame {
      grid-area: frame;
      align-self: center;
    }

    .product--split .product__frame .frame__window,
    .product--split .product__frame .frame__window img {
      aspect-ratio: 4 / 3.5;
    }

    .product--split .product__facts {
      grid-area: facts;
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
</style>
