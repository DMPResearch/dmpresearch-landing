---
import type { Product } from '../content/site';
import '../styles/product.css';

interface Props {
  product: Product;
  layout: 'wide' | 'split';
}

const { product, layout } = Astro.props;
const {
  id,
  index,
  name,
  tint,
  mark,
  imageLight,
  imageDark,
  imageAlt,
  title,
  text,
  points,
  link,
  facts,
  screens,
  screensLabel,
} = product;

const featuredChrome = link.href.replace(/^https?:\/\//, '');
const extraScreens = screens.filter((screen) => screen.id !== screens[0]?.id);
---

<section
  class:list={['product', 'section', `product--${layout}`, `product--${tint}`]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="product__inner container">
    <header class="product__head" data-reveal>
      <p class="product__meta">
        <span class="mono">{index}</span>
        <span class="product__name">
          <img src={mark} width="28" height="28" alt="" />
          {name}
        </span>
      </p>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="lede product__text">{text}</p>
      <ul class="product__points">
        {points.map((point) => <li>{point}</li>)}
      </ul>
      <a class="btn btn--ghost product__cta" href={link.href} target="_blank" rel="noopener">
        {link.label}
        <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="product__media">
      <figure
        class:list={['frame', `frame--${tint}`, 'product__frame']}
        data-reveal
        data-inview
        style="--delay: 120ms"
      >
        <div class="frame__glow" aria-hidden="true"></div>
        <div class="frame__window">
          <div class="product__chrome" aria-hidden="true">
            <i></i><i></i><i></i>
            <span>{featuredChrome}</span>
          </div>
          <img
            class="theme-shot theme-shot--light data-inview-media"
            src={imageLight}
            width="1288"
            height="900"
            alt={imageAlt}
            loading="lazy"
            decoding="async"
          />
          <img
            class="theme-shot theme-shot--dark data-inview-media"
            src={imageDark}
            width="1288"
            height="900"
            alt={imageAlt}
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>

      {extraScreens.length > 0 && (
        <div class="product__gallery" data-reveal style="--delay: 180ms">
          <p class="mono product__gallery-label">{screensLabel}</p>
          <ul class="product__gallery-list">
            {extraScreens.map((screen, index) => (
              <li class="product__gallery-item" style={`--i: ${index}`}>
                <figure class:list={['frame', `frame--${tint}`, 'product__gallery-frame']}>
                  <div class="frame__window">
                    <div class="product__chrome" aria-hidden="true">
                      <i></i><i></i><i></i>
                      <span>{screen.chrome}</span>
                    </div>
                    <img
                      class="theme-shot theme-shot--light"
                      src={screen.imageLight}
                      width="960"
                      height="600"
                      alt={screen.imageAlt}
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      class="theme-shot theme-shot--dark"
                      src={screen.imageDark}
                      width="960"
                      height="600"
                      alt={screen.imageAlt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </figure>
                <p class="product__gallery-caption">{screen.label}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <dl class="product__facts" data-reveal style="--delay: 200ms">
      {facts.map((fact) => (
        <div class="product__fact">
          <dt class="mono">{fact.term}</dt>
          <dd>{fact.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
