---
import { contact } from '../content/site';
---

<script define:vars={{ calendlyUrl: contact.calendlyUrl }}>
  const CSS_HREF = 'https://assets.calendly.com/assets/external/widget.css';
  const JS_SRC = 'https://assets.calendly.com/assets/external/widget.js';

  const themed = {
    dark: 'background_color=0e141b&text_color=eef3ec&primary_color=2fd6c8',
    light: 'background_color=ffffff&text_color=12161c&primary_color=0f9f96',
  };

  const bookingUrl = () => {
    const resolved =
      document.documentElement.getAttribute('data-resolved') === 'dark' ? 'dark' : 'light';
    return `${calendlyUrl}?${themed[resolved]}`;
  };

  const allowsThirdParty = () => {
    const consent = window.dmprGetConsent?.();
    return Boolean(consent?.thirdParty);
  };

  const openExternal = () => {
    window.open(calendlyUrl, '_blank', 'noopener,noreferrer');
  };

  let loadPromise = null;

  const loadAssets = () => {
    if (window.Calendly?.initPopupWidget) return Promise.resolve(true);
    if (loadPromise) return loadPromise;

    loadPromise = new Promise((resolve) => {
      if (!document.querySelector(`link[href="${CSS_HREF}"]`)) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = CSS_HREF;
        document.head.appendChild(link);
      }

      const existing = document.querySelector(`script[src="${JS_SRC}"]`);
      if (existing) {
        existing.addEventListener('load', () => resolve(true));
        if (window.Calendly?.initPopupWidget) resolve(true);
        return;
      }

      const script = document.createElement('script');
      script.src = JS_SRC;
      script.async = true;
      script.onload = () => resolve(true);
      script.onerror = () => resolve(false);
      document.body.appendChild(script);
    });

    return loadPromise;
  };

  const openPopup = async () => {
    const ready = await loadAssets();
    if (!ready || !window.Calendly?.initPopupWidget) return false;
    window.Calendly.initPopupWidget({ url: bookingUrl() });
    return true;
  };

  const openCalendly = async (event) => {
    event?.preventDefault?.();

    if (!allowsThirdParty()) {
      openExternal();
      return;
    }

    const opened = await openPopup();
    if (!opened) openExternal();
  };

  const preloadIfAllowed = () => {
    if (allowsThirdParty()) loadAssets();
  };

  const bind = () => {
    document.querySelectorAll('[data-calendly-open]').forEach((el) => {
      if (el.dataset.calendlyBound === '1') return;
      el.dataset.calendlyBound = '1';
      el.addEventListener('click', openCalendly);
    });
  };

  bind();
  preloadIfAllowed();
  document.addEventListener('astro:page-load', () => {
    bind();
    preloadIfAllowed();
  });
  window.addEventListener('dmpr:consent', preloadIfAllowed);

  window.dmprOpenCalendly = openCalendly;
</script>
