---
import { contact, cta } from '../content/site';
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="contact__wash" aria-hidden="true"></div>
  <div class="contact__layout container">
    <div class="contact__intro" data-reveal>
      <p class="kicker">Work with us</p>
      <h2 id="contact-title">{cta.title}</h2>
      <p class="lede contact__text">{cta.text}</p>
      <a class="link contact__email" href={contact.href}>{contact.email}</a>
    </div>

    <form
      class="contact__form"
      name="contact"
      method="POST"
      action="/?success=1#contact"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-reveal
      style="--delay: 100ms"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="contact__honey" hidden>
        <label>
          Do not fill this out
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <label class="contact__field">
        <span>{cta.fields.name}</span>
        <input type="text" name="name" required autocomplete="name" maxlength="120" />
      </label>

      <label class="contact__field">
        <span>{cta.fields.email}</span>
        <input type="email" name="email" required autocomplete="email" maxlength="160" />
      </label>

      <label class="contact__field">
        <span>{cta.fields.company}</span>
        <input type="text" name="company" autocomplete="organization" maxlength="160" />
      </label>

      <label class="contact__field contact__field--full">
        <span>{cta.fields.message}</span>
        <textarea name="message" required rows="5" maxlength="4000"></textarea>
      </label>

      <button class="btn btn--solid contact__submit" type="submit">
        {cta.fields.submit}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>

      <p class="contact__success" hidden data-form-success>{cta.formSuccess}</p>
    </form>
  </div>
</section>

<script>
  const params = new URLSearchParams(window.location.search);
  if (params.get('success') === '1') {
    const note = document.querySelector('[data-form-success]');
    if (note instanceof HTMLElement) {
      note.hidden = false;
      document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

<style>
  .contact {
    position: relative;
    overflow: clip;
  }

  .contact__wash {
    position: absolute;
    left: 50%;
    bottom: -45%;
    width: min(980px, 130vw);
    height: 75%;
    transform: translateX(-50%);
    pointer-events: none;
    background: var(--grad);
    opacity: 0.18;
    filter: blur(110px);
    border-radius: 50%;
  }

  .contact__layout {
    position: relative;
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: start;
  }

  .contact__intro {
    display: grid;
    gap: var(--s-4);
    max-width: 34rem;
  }

  .contact__intro h2 {
    font-size: clamp(2.2rem, 1.4rem + 2.8vw, 3.4rem);
    max-width: 12ch;
  }

  .contact__email {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--fg-2);
    text-transform: none;
    letter-spacing: 0;
  }

  .contact__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    padding: clamp(22px, 3vw, 28px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-2) 90%, transparent);
    box-shadow: var(--shadow-frame);
  }

  .contact__honey {
    position: absolute;
    left: -9999px;
  }

  .contact__field {
    display: grid;
    gap: 8px;
  }

  .contact__field span {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--fg-2);
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-3);
    color: var(--fg);
    font: inherit;
    resize: vertical;
    transition: border-color 160ms var(--ease), box-shadow 160ms var(--ease);
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 22%, transparent);
  }

  .contact__submit {
    justify-self: start;
    margin-top: 8px;
    min-height: 52px;
  }

  .contact__success {
    grid-column: 1 / -1;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--olive) 40%, transparent);
    background: color-mix(in srgb, var(--olive) 12%, transparent);
    color: var(--fg);
    font-size: var(--t-small);
  }

  @media (min-width: 900px) {
    .contact__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .contact__form {
      grid-template-columns: 1fr 1fr;
    }

    .contact__field--full,
    .contact__submit,
    .contact__success {
      grid-column: 1 / -1;
    }
  }
</style>
