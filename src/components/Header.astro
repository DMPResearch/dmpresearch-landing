---
import { frontmatter as site } from '../content/site-labels.md';

const { header, contact } = site;
---

<header class="header">
  <div class="header__inner container">
    <a class="header__brand" href="#top" aria-label="DMPResearch, back to top">
      <img src="/mark.svg" width="28" height="28" alt="" />
      <span>{header.wordmark}</span>
    </a>

    <nav class="header__nav" aria-label="Site">
      <ul id="site-nav" class="header__list">
        {header.navLinks.map((link: { label: string; href: string }) => (
          <li><a class="header__link" href={link.href}>{link.label}</a></li>
        ))}
        <li class="header__list-cta">
          <a class="header__link header__link--cta" href={contact.href}>{header.ctaLabel}</a>
        </li>
      </ul>
    </nav>

    <a class="header__email" href={contact.href}>{header.ctaLabel}</a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="header__toggle-open">Menu</span>
      <span class="header__toggle-close">Close</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.header') as HTMLElement | null;
  const toggle = document.querySelector('.header__toggle') as HTMLButtonElement | null;

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('is-open'));
    });

    header.querySelectorAll('.header__link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(244, 241, 234, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    height: 64px;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 24;
  }

  .header__brand img {
    border-radius: 7px;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .header__list-cta {
    display: none;
  }

  .header__link {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding: var(--s-2) 0;
    border-bottom: 1px solid transparent;
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  .header__link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .header__email {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 10px 16px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }

  .header__email:hover {
    background: var(--ink);
    color: var(--on-ink);
  }

  .header__toggle {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 10px 14px;
    border: 1px solid var(--ink);
    border-radius: 999px;
  }

  .header__toggle-close {
    display: none;
  }

  @media (max-width: 820px) {
    .header__email {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }

    .header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      box-shadow: var(--shadow-plate);
    }

    .header.is-open .header__nav {
      display: block;
    }

    .header.is-open .header__toggle-open {
      display: none;
    }

    .header.is-open .header__toggle-close {
      display: inline;
    }

    .header__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
      padding: var(--s-3) 0 var(--s-5);
    }

    .header__list li + li {
      border-top: 1px solid var(--rule);
    }

    .header__list-cta {
      display: block;
    }

    .header__link {
      display: flex;
      justify-content: space-between;
      font-family: var(--font-display);
      font-size: 1.75rem;
      letter-spacing: -0.01em;
      text-transform: none;
      color: var(--ink);
      padding: 18px 0;
      border-bottom: 0;
      font-variation-settings: 'opsz' 36;
    }

    .header__link:hover {
      border-bottom: 0;
    }

    .header__link--cta::after {
      content: '→';
      font-family: var(--font-mono);
      font-size: 1.1rem;
    }
  }
</style>
