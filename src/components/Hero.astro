---
import { frontmatter as site } from '../content/site-labels.md';

const { hero } = site;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="kicker hero__kicker" style="--i: 0">
        <b>{hero.kicker}</b>
        <span aria-hidden="true">·</span>
        <span>{hero.kickerDetail}</span>
      </p>

      <h1 id="hero-title" class="hero__title" style="--i: 1">
        {hero.titleLead}<br />
        <em>{hero.titleEmphasis}</em><br />
        {hero.titleTail}
      </h1>

      <p class="lede hero__lede" style="--i: 2">{hero.lede}</p>

      <div class="hero__actions" style="--i: 3">
        <a class="btn btn--solid" href={hero.primary.href}>
          {hero.primary.label}
          <span class="btn__arrow" aria-hidden="true">↓</span>
        </a>
        <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>

    <nav class="hero__contents" aria-label="Page contents" style="--i: 2">
      <p class="kicker hero__contents-label">{hero.contentsLabel}</p>
      <ol class="hero__toc">
        {hero.contents.map((item: { number: string; label: string; note: string; href: string }) => (
          <li>
            <a class="hero__toc-link" href={item.href}>
              <span class="hero__toc-number">{item.number}</span>
              <span class="hero__toc-label">{item.label}</span>
              <span class="hero__toc-note">{item.note}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <div class="hero__facts-wrap">
    <div class="rule-grad" aria-hidden="true"></div>
    <ul class="hero__facts container" aria-label="Studio at a glance">
      {hero.facts.map((fact: string) => <li>{fact}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
  }

  /* Faint ruled-paper lines behind the cover page. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 47px,
      rgba(14, 18, 22, 0.05) 47px 48px
    );
    mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
    padding-block: clamp(56px, 8vw, 120px) clamp(48px, 7vw, 96px);
  }

  .hero__copy {
    display: grid;
    gap: var(--s-6);
    max-width: 760px;
  }

  .hero__title em {
    font-style: italic;
    font-weight: 400;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.04em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* Contents panel */
  .hero__contents {
    align-self: end;
    border-top: 1px solid var(--ink);
    padding-top: var(--s-4);
  }

  .hero__contents-label {
    margin-bottom: var(--s-2);
  }

  .hero__toc li {
    border-bottom: 1px solid var(--rule);
  }

  .hero__toc-link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: var(--s-3);
    padding: 14px 0;
    transition: padding-left 220ms var(--ease-out);
  }

  .hero__toc-link:hover {
    padding-left: var(--s-2);
  }

  .hero__toc-number {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-3);
  }

  .hero__toc-label {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 36;
  }

  .hero__toc-note {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.04em;
    color: var(--ink-3);
    text-align: right;
  }

  /* Narrow phones: keep the label on one line, tuck the note beneath it. */
  @media (max-width: 480px) {
    .hero__toc-link {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        'number label'
        'number note';
      row-gap: var(--s-1);
    }

    .hero__toc-number {
      grid-area: number;
    }

    .hero__toc-label {
      grid-area: label;
    }

    .hero__toc-note {
      grid-area: note;
      text-align: left;
    }
  }

  /* Facts strip */
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    padding-block: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .hero__facts li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .hero__facts li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
  }

  /* One-shot page load stagger. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > *,
    .hero__contents {
      opacity: 0;
      animation: rise 700ms var(--ease-out) forwards;
      animation-delay: calc(80ms + var(--i, 0) * 110ms);
    }
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(280px, 4fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: end;
    }

    .hero__toc-label {
      font-size: 1.65rem;
    }
  }
</style>
