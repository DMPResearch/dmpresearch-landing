---
import { contact, footer } from '../content/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__row">
      <a class="footer__brand" href="#top">
        <img src="/mark.svg" width="24" height="24" alt="" />
        <span>DMPResearch</span>
      </a>

      <nav aria-label="Footer">
        <ul class="footer__links">
          {footer.links.map((link) => (
            <li>
              <a class="footer__link" href={link.href} target="_blank" rel="noopener">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a class="footer__link" href={contact.href}>{contact.email}</a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="mono footer__copy">
      © {year} DMPResearch ·{' '}
      <a class="footer__built" href={footer.builtWith.href} target="_blank" rel="noopener">
        {footer.builtWith.label}
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .footer__inner {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-6) calc(var(--s-7) + env(safe-area-inset-bottom, 0px));
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__brand img {
    border-radius: 6px;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
  }

  .footer__link {
    font-size: 0.875rem;
    color: var(--fg-2);
    transition: color 160ms var(--ease);
  }

  .footer__link:hover {
    color: var(--fg);
  }

  .footer__copy {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--fg-3);
  }

  .footer__built {
    color: var(--teal);
    transition: color 160ms var(--ease);
  }

  .footer__built:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .footer__row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-4);
    }

    .footer__links {
      flex-direction: column;
      gap: 10px;
    }

    .footer__link {
      font-size: 0.95rem;
    }
  }
</style>
