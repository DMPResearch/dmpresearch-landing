---
import { consentCopy } from '../content/legal';
---

<div class="cookie" data-cookie-root hidden>
  <div
    class="cookie__banner"
    data-cookie-banner
    role="dialog"
    aria-modal="false"
    aria-labelledby="cookie-title"
    aria-describedby="cookie-text"
  >
    <div class="cookie__copy">
      <h2 id="cookie-title">{consentCopy.title}</h2>
      <p id="cookie-text">
        {consentCopy.text}
        {' '}
        <a href={consentCopy.privacyLink.href}>{consentCopy.privacyLink.label}</a>
        {' · '}
        <a href={consentCopy.cookiesLink.href}>{consentCopy.cookiesLink.label}</a>
      </p>
    </div>
    <div class="cookie__actions">
      <button class="btn btn--ghost cookie__btn" type="button" data-cookie-reject>
        {consentCopy.reject}
      </button>
      <button class="btn btn--ghost cookie__btn" type="button" data-cookie-customize>
        {consentCopy.customize}
      </button>
      <button class="btn btn--solid cookie__btn" type="button" data-cookie-accept>
        {consentCopy.acceptAll}
      </button>
    </div>
  </div>

  <div
    class="cookie__panel"
    data-cookie-panel
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="cookie-panel-title"
  >
    <div class="cookie__panel-card">
      <div class="cookie__panel-head">
        <h2 id="cookie-panel-title">{consentCopy.title}</h2>
        <button class="cookie__icon-btn" type="button" data-cookie-close aria-label={consentCopy.close}>
          ×
        </button>
      </div>

      <label class="cookie__option">
        <span class="cookie__option-copy">
          <strong>{consentCopy.categories.necessary.title}</strong>
          <span>{consentCopy.categories.necessary.text}</span>
        </span>
        <span class="cookie__switch">
          <input
            class="cookie__switch-input"
            type="checkbox"
            checked
            disabled
            data-cookie-necessary
            aria-label={consentCopy.categories.necessary.title}
          />
          <span class="cookie__switch-ui" aria-hidden="true"></span>
        </span>
      </label>

      <label class="cookie__option">
        <span class="cookie__option-copy">
          <strong>{consentCopy.categories.thirdParty.title}</strong>
          <span>{consentCopy.categories.thirdParty.text}</span>
        </span>
        <span class="cookie__switch">
          <input
            class="cookie__switch-input"
            type="checkbox"
            data-cookie-third-party
            aria-label={consentCopy.categories.thirdParty.title}
          />
          <span class="cookie__switch-ui" aria-hidden="true"></span>
        </span>
      </label>

      <div class="cookie__panel-actions">
        <button class="btn btn--ghost cookie__btn" type="button" data-cookie-reject>
          {consentCopy.reject}
        </button>
        <button class="btn btn--solid cookie__btn" type="button" data-cookie-save>
          {consentCopy.save}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'dmpr-consent';
  const VERSION = 1;

  type ConsentState = {
    version: number;
    necessary: true;
    thirdParty: boolean;
    decidedAt: string;
  };

  const root = document.querySelector('[data-cookie-root]') as HTMLElement | null;
  const banner = document.querySelector('[data-cookie-banner]') as HTMLElement | null;
  const panel = document.querySelector('[data-cookie-panel]') as HTMLElement | null;
  const thirdPartyInput = document.querySelector(
    '[data-cookie-third-party]',
  ) as HTMLInputElement | null;

  const readConsent = (): ConsentState | null => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as ConsentState;
      if (parsed.version !== VERSION || typeof parsed.thirdParty !== 'boolean') return null;
      return parsed;
    } catch {
      return null;
    }
  };

  const writeConsent = (thirdParty: boolean) => {
    const state: ConsentState = {
      version: VERSION,
      necessary: true,
      thirdParty,
      decidedAt: new Date().toISOString(),
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    window.dispatchEvent(new CustomEvent('dmpr:consent', { detail: state }));
    return state;
  };

  const showRoot = (open: boolean) => {
    if (!root) return;
    root.hidden = !open;
  };

  const showBanner = (open: boolean) => {
    if (!banner) return;
    banner.hidden = !open;
  };

  const showPanel = (open: boolean) => {
    if (!panel) return;
    panel.hidden = !open;
    if (open) {
      const current = readConsent();
      if (thirdPartyInput) thirdPartyInput.checked = Boolean(current?.thirdParty);
    }
  };

  const closeAll = () => {
    showBanner(false);
    showPanel(false);
    showRoot(false);
  };

  const openSettings = () => {
    showRoot(true);
    showBanner(false);
    showPanel(true);
  };

  const decide = (thirdParty: boolean) => {
    writeConsent(thirdParty);
    closeAll();
  };

  const existing = readConsent();
  if (!existing) {
    showRoot(true);
    showBanner(true);
    showPanel(false);
  } else {
    window.dispatchEvent(new CustomEvent('dmpr:consent', { detail: existing }));
  }

  root?.querySelectorAll('[data-cookie-accept]').forEach((el) => {
    el.addEventListener('click', () => decide(true));
  });
  root?.querySelectorAll('[data-cookie-reject]').forEach((el) => {
    el.addEventListener('click', () => decide(false));
  });
  root?.querySelectorAll('[data-cookie-customize]').forEach((el) => {
    el.addEventListener('click', () => {
      showBanner(false);
      showPanel(true);
    });
  });
  root?.querySelectorAll('[data-cookie-save]').forEach((el) => {
    el.addEventListener('click', () => decide(Boolean(thirdPartyInput?.checked)));
  });
  root?.querySelectorAll('[data-cookie-close]').forEach((el) => {
    el.addEventListener('click', () => {
      if (readConsent()) closeAll();
      else {
        showPanel(false);
        showBanner(true);
      }
    });
  });

  document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      openSettings();
    });
  });

  window.dmprGetConsent = readConsent;
  window.dmprOpenCookieSettings = openSettings;
</script>

<style>
  .cookie {
    position: fixed;
    inset: auto 0 0;
    z-index: 120;
    pointer-events: none;
  }

  .cookie__banner,
  .cookie__panel {
    pointer-events: auto;
  }

  .cookie__banner {
    display: grid;
    gap: 12px;
    width: min(100% - 2 * var(--gutter), 720px);
    margin: 0 auto calc(12px + env(safe-area-inset-bottom, 0px));
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background:
      linear-gradient(160deg, var(--card-sheen), transparent 55%),
      color-mix(in srgb, var(--bg-2) 94%, transparent);
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(16px) saturate(140%);
  }

  .cookie__copy {
    display: grid;
    gap: 4px;
  }

  .cookie__copy h2 {
    font-size: 0.95rem;
  }

  .cookie__copy p {
    color: var(--fg-2);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .cookie__copy a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie__actions,
  .cookie__panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cookie__btn {
    min-height: 36px;
    padding-inline: 14px;
    font-size: 0.8125rem;
  }

  .cookie__panel {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: end end;
    padding: 12px;
    padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--bg) 40%, transparent);
    backdrop-filter: blur(2px);
  }

  .cookie__panel-card {
    width: min(100%, 320px);
    display: grid;
    gap: 10px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-2);
    box-shadow: var(--card-shadow);
  }

  .cookie__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .cookie__panel-head h2 {
    font-size: 1rem;
  }

  .cookie__icon-btn {
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .cookie__option {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-3);
    cursor: pointer;
  }

  .cookie__option:has(.cookie__switch-input:disabled) {
    cursor: default;
  }

  .cookie__option-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .cookie__option-copy strong {
    font-size: 0.84rem;
  }

  .cookie__option-copy span {
    color: var(--fg-3);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .cookie__switch {
    position: relative;
    width: 40px;
    height: 24px;
    flex-shrink: 0;
  }

  .cookie__switch-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
  }

  .cookie__switch-input:disabled {
    cursor: default;
  }

  .cookie__switch-ui {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 16%, transparent);
    border: 1px solid var(--line-2);
    transition:
      background 180ms var(--ease),
      border-color 180ms var(--ease);
  }

  .cookie__switch-ui::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--bg);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--fg) 25%, transparent);
    transition: transform 180ms var(--ease);
  }

  .cookie__switch-input:checked + .cookie__switch-ui {
    background: var(--teal);
    border-color: color-mix(in srgb, var(--teal) 70%, transparent);
  }

  .cookie__switch-input:checked + .cookie__switch-ui::after {
    transform: translateX(16px);
  }

  .cookie__switch-input:disabled + .cookie__switch-ui {
    opacity: 0.85;
  }

  .cookie__switch-input:focus-visible + .cookie__switch-ui {
    outline: 2px solid color-mix(in srgb, var(--teal) 55%, transparent);
    outline-offset: 2px;
  }

  .cookie__panel-actions {
    justify-content: space-between;
    margin-top: 2px;
  }

  @media (min-width: 800px) {
    .cookie__banner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      width: min(100% - 2 * var(--gutter), 780px);
    }

    .cookie__actions {
      justify-content: end;
    }

    .cookie__panel {
      place-items: end end;
      padding: 20px;
    }
  }
</style>
