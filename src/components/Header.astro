---
import { contact, nav } from '../content/site';
import { defaultLocale, getChrome } from '../i18n/config';
import ThemeSwitch from './ThemeSwitch.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const chrome = getChrome(defaultLocale);

const navHref = (href: string) => {
  if (!href.startsWith('/#')) return href;
  return isHome ? href.slice(1) : href;
};

const navId = (href: string) => {
  if (href.startsWith('/#')) return href.slice(2);
  if (href.startsWith('#')) return href.slice(1);
  return href.replace(/^\//, '');
};
---

<header class="header" data-header>
  <div class="header__progress" aria-hidden="true">
    <div class="header__progress-bar" data-scroll-progress></div>
  </div>
  <div class="header__inner container">
    <a class="header__brand" href={isHome ? '#top' : '/'} aria-label="DMPResearch, back to top">
      <img src="/mark.svg" width="28" height="28" alt="" />
      <span>DMPResearch</span>
    </a>

    <nav class="header__nav" aria-label={chrome.siteNav}>
      <ul id="site-nav" class="header__list">
        {nav.map((link) => {
          const href = navHref(link.href);
          const id = navId(link.href);
          const current =
            (!isHome && link.href === path) ||
            (!isHome && link.href === `${path}/`) ||
            path === link.href;
          return (
            <li>
              <a
                class:list={['header__link', { 'is-active': current }]}
                href={href}
                data-nav-link={isHome && href.startsWith('#') ? id : undefined}
                aria-current={current ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
        <li class="header__list-cta">
          <button class="header__link" type="button" data-calendly-open>{contact.bookLabel}</button>
        </li>
      </ul>
    </nav>

    <div class="header__tools">
      <ThemeSwitch />
      <button class="btn btn--solid header__cta" type="button" data-calendly-open>
        {contact.bookLabel}
      </button>
      <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="header__toggle-open">{chrome.menu}</span>
        <span class="header__toggle-close">{chrome.close}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]') as HTMLElement | null;
  const toggle = document.querySelector('.header__toggle') as HTMLButtonElement | null;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    header.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
    header.querySelectorAll('button[data-calendly-open]').forEach((button) => {
      button.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }

  // Scrollspy: highlight the nav item for the section in view (home only).
  const ids = links.map((link) => link.dataset.navLink).filter(Boolean) as string[];
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  const setActive = (id: string | null) => {
    links.forEach((link) => {
      const active = link.dataset.navLink === id;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };

  if (sections.length && 'IntersectionObserver' in window) {
    const ratios = new Map<string, number>();
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          ratios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
        }
        let bestId: string | null = null;
        let best = 0;
        for (const [id, ratio] of ratios) {
          if (ratio > best) {
            best = ratio;
            bestId = id;
          }
        }
        if (bestId) setActive(bestId);
      },
      { rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.15, 0.35, 0.55, 0.75] },
    );
    sections.forEach((section) => spy.observe(section));
  }

  const syncHeaderHeight = () => {
    if (!header) return;
    const height = Math.ceil(header.getBoundingClientRect().height);
    document.documentElement.style.setProperty('--header-h', `${height}px`);
  };

  const onScroll = () => {
    if (!header) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    header.style.setProperty('--scroll-progress', progress.toFixed(4));
    header.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  onScroll();
  syncHeaderHeight();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    syncHeaderHeight();
    onScroll();
  }, { passive: true });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 1px solid transparent;
    box-shadow: 0 1px 0 color-mix(in srgb, #fff 40%, transparent) inset;
    transition:
      border-color 220ms var(--ease),
      box-shadow 220ms var(--ease);
  }

  /* Frost lives on a layer so nav text stays sharp while the bar blurs the page. */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--header-bg-idle);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    transition: background 220ms var(--ease);
    pointer-events: none;
  }

  .header > * {
    position: relative;
    z-index: 1;
  }

  .header.is-scrolled {
    border-bottom-color: color-mix(in srgb, var(--line) 80%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, #fff 45%, transparent) inset,
      0 10px 28px -22px color-mix(in srgb, var(--fg) 28%, transparent);
  }

  .header.is-scrolled::before {
    background: var(--header-bg);
  }

  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
    background: color-mix(in srgb, var(--line) 70%, transparent);
  }

  .header__progress-bar {
    height: 100%;
    width: 100%;
    transform-origin: left center;
    transform: scaleX(var(--scroll-progress, 0));
    background: var(--grad);
    will-change: transform;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    height: var(--header-h);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .header__brand img {
    border-radius: 8px;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .header__list-cta {
    display: none;
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-3);
    border-radius: 999px;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: color 160ms var(--ease), background 160ms var(--ease);
  }

  .header__link:hover {
    color: var(--fg);
  }

  .header__link.is-active {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .header__link.is-active::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    border-radius: 999px;
    background: var(--grad);
  }

  .header__cta {
    min-height: 40px;
    padding-inline: var(--s-4);
    font-size: 0.875rem;
  }

  .header__toggle {
    display: none;
    min-height: 40px;
    padding: 0 var(--s-4);
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--line-2);
    border-radius: 999px;
  }

  .header__toggle-close {
    display: none;
  }

  @media (max-width: 860px) {
    .header__inner {
      height: 64px;
      gap: var(--s-3);
      align-items: center;
    }

    .header__brand {
      font-size: 1.12rem;
      gap: 10px;
      line-height: 1;
    }

    .header__brand img {
      width: 30px;
      height: 30px;
    }

    .header__tools {
      gap: 10px;
      align-items: center;
    }

    .header__cta {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 16px;
      font-size: 0.94rem;
      font-weight: 550;
    }

    .header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(18px);
    }

    .header.is-open .header__nav {
      display: block;
    }

    .header.is-open .header__toggle-open {
      display: none;
    }

    .header.is-open .header__toggle-close {
      display: inline;
    }

    .header__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
      padding: var(--s-3) 0 var(--s-6);
    }

    .header__list li + li {
      border-top: 1px solid var(--line);
    }

    .header__list-cta {
      display: block;
    }

    .header__link {
      display: block;
      font-family: var(--font-display);
      font-size: 1.9rem;
      font-weight: 550;
      letter-spacing: -0.03em;
      color: var(--fg);
      padding: 20px 0;
      border-radius: 0;
      background: transparent;
    }

    .header__link.is-active::after {
      display: none;
    }

    .header__link.is-active {
      color: var(--teal);
      background: transparent;
    }
  }
</style>
