<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) return;

    const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    let ticking = false;

    const updateParallax = () => {
      const midY = window.innerHeight * 0.5;
      for (const el of parallaxEls) {
        const speed = Number(el.dataset.parallax || 0.12);
        const rect = el.getBoundingClientRect();
        const center = rect.top + rect.height * 0.5;
        const offset = (center - midY) * -speed;
        el.style.setProperty('--parallax-y', `${offset.toFixed(1)}px`);
      }
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateParallax);
    };

    if (parallaxEls.length) {
      updateParallax();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }

    document.querySelectorAll<HTMLElement>('[data-spotlight-group]').forEach((group) => {
      const items = Array.from(group.querySelectorAll<HTMLElement>('[data-spotlight]'));
      if (!items.length) return;

      const ratios = new Map<HTMLElement, number>();
      const pick = () => {
        let best: HTMLElement | null = null;
        let score = -1;
        for (const [el, ratio] of ratios) {
          if (ratio > score) {
            score = ratio;
            best = el;
          }
        }
        items.forEach((el) => el.classList.toggle('is-spotlight', el === best));
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            ratios.set(
              entry.target as HTMLElement,
              entry.isIntersecting ? entry.intersectionRatio : 0,
            );
          }
          pick();
        },
        { rootMargin: '-18% 0px -42% 0px', threshold: [0.2, 0.45, 0.7] },
      );

      items.forEach((item) => io.observe(item));
    });

    document.querySelectorAll<HTMLElement>('[data-inview]').forEach((el) => {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-inview');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.25 },
      );
      io.observe(el);
    });
  })();
</script>
