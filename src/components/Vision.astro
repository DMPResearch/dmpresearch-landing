---
import { gretly } from '../content/site';
---

<section class="gretly section" id="gretly" aria-labelledby="gretly-title">
  <div class="container">
    <header class="gretly__head" data-reveal>
      <p class="kicker">{gretly.kicker}</p>
      <h2 id="gretly-title">{gretly.title}</h2>
      <p class="lede">{gretly.text}</p>
      <blockquote class="gretly__quote">{gretly.sentence}</blockquote>
    </header>

    <div class="gretly__principles">
      {gretly.principles.map((item, index) => (
        <article class="gretly__card" data-reveal style={`--delay: ${index * 80}ms`}>
          <span class="mono">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>

    <div class="gretly__map" data-reveal>
      <div class="gretly__map-head">
        <p class="mono">Portfolio map</p>
        <p class="gretly__engine">{gretly.engine}</p>
      </div>
      <ul class="gretly__products">
        {gretly.products.map((item) => (
          <li class:list={['gretly__product', item.status.startsWith('Live') && 'is-live']}>
            <div>
              <strong>{item.name}</strong>
              <span>{item.note}</span>
            </div>
            <em>{item.status}</em>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .gretly {
    position: relative;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 40% at 10% 0%, rgba(91, 108, 255, 0.12), transparent 60%),
      radial-gradient(ellipse 50% 35% at 90% 100%, rgba(182, 209, 42, 0.08), transparent 55%);
  }

  .gretly__head {
    display: grid;
    gap: var(--s-5);
    max-width: 760px;
    margin-bottom: clamp(48px, 7vw, 80px);
  }

  .gretly__quote {
    margin: 8px 0 0;
    padding: 20px 22px;
    border-left: 2px solid transparent;
    border-image: var(--grad) 1;
    background: rgba(255, 255, 255, 0.03);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    max-width: 46ch;
  }

  .gretly__principles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .gretly__card {
    display: grid;
    gap: 12px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(14, 20, 27, 0.7);
    transition: border-color 200ms var(--ease), transform 200ms var(--ease);
  }

  .gretly__card:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }

  .gretly__card h3 {
    font-size: 1.25rem;
  }

  .gretly__card p {
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  .gretly__map {
    display: grid;
    gap: var(--s-5);
    padding: clamp(24px, 3vw, 32px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background:
      linear-gradient(145deg, rgba(91, 108, 255, 0.08), transparent 40%),
      rgba(14, 20, 27, 0.85);
    box-shadow: var(--shadow-frame);
  }

  .gretly__map-head {
    display: grid;
    gap: 12px;
    max-width: 70ch;
  }

  .gretly__engine {
    color: var(--fg-2);
    font-size: var(--t-small);
    line-height: 1.55;
  }

  .gretly__products {
    display: grid;
    gap: 0;
  }

  .gretly__product {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  .gretly__product div {
    display: grid;
    gap: 4px;
  }

  .gretly__product strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .gretly__product span {
    color: var(--fg-3);
    font-size: 0.88rem;
  }

  .gretly__product em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-3);
    white-space: nowrap;
  }

  .gretly__product.is-live em {
    color: var(--olive);
  }

  @media (min-width: 800px) {
    .gretly__principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .gretly__principles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
