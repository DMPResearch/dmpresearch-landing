---
import { contact, footer } from '../content/site';

const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__row">
      <div class="footer__brand-block">
        <a class="footer__brand" href={isHome ? '#top' : '/'}>
          <img src="/mark.svg" width="22" height="22" alt="" />
          <span>{footer.brand}</span>
        </a>
        <span class="footer__tagline">{footer.tagline}</span>
      </div>

      <nav aria-label={footer.navLabel}>
        <ul class="footer__links">
          {footer.links.map((link) => {
            const external = link.href.startsWith('http');
            return (
              <li>
                <a
                  class="footer__link"
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
          <li>
            <a class="footer__link footer__link--email" href={contact.href}>{contact.email}</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer__meta">
      <p class="mono footer__copy">© {year} {footer.brand}</p>
      <a class="mono footer__built" href={footer.builtWith.href} target="_blank" rel="noopener">
        {footer.builtWith.label}
        <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .footer__inner {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-6) calc(var(--s-5) + env(safe-area-inset-bottom, 0px));
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
  }

  .footer__brand-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__brand img {
    border-radius: 6px;
  }

  .footer__tagline {
    font-size: 0.875rem;
    color: var(--fg-3);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  .footer__link {
    font-size: 0.875rem;
    color: var(--fg-2);
    transition: color 160ms var(--ease);
  }

  .footer__link:hover {
    color: var(--fg);
  }

  .footer__link--email {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .footer__copy,
  .footer__built {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .footer__built {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--teal);
    transition: color 160ms var(--ease);
  }

  .footer__built:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .footer__row,
    .footer__brand-block {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .footer__link {
      font-size: 0.95rem;
    }
  }
</style>
