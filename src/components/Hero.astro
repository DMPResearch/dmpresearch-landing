---
import { hero, products } from '../content/site';
import '../styles/hero.css';

const [flowstarter, ereno] = products;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__pattern" aria-hidden="true"></div>

  <svg
    class="hero__ribbon hero__ribbon--left"
    viewBox="0 0 420 520"
    fill="none"
    aria-hidden="true"
    data-parallax="0.12"
  >
    <path
      class="hero__ribbon-glow"
      d="M48 40c72 48 94 118 78 176-18 66-92 92-74 168 14 58 86 96 156 118"
      stroke="url(#ribbon-left)"
      stroke-width="64"
      stroke-linecap="round"
    />
    <path
      class="hero__ribbon-stroke"
      d="M48 40c72 48 94 118 78 176-18 66-92 92-74 168 14 58 86 96 156 118"
      stroke="url(#ribbon-left)"
      stroke-width="46"
      stroke-linecap="round"
    />
    <defs>
      <linearGradient id="ribbon-left" x1="40" y1="40" x2="280" y2="500" gradientUnits="userSpaceOnUse">
        <stop style="stop-color: var(--olive)" />
        <stop offset="0.55" style="stop-color: var(--teal)" />
        <stop offset="1" style="stop-color: var(--blue)" />
      </linearGradient>
    </defs>
  </svg>

  <svg
    class="hero__ribbon hero__ribbon--right"
    viewBox="0 0 460 540"
    fill="none"
    aria-hidden="true"
    data-parallax="0.18"
  >
    <path
      class="hero__ribbon-glow"
      d="M380 60c-90 36-150 96-138 168 14 82 118 98 96 188-16 64-96 108-180 132"
      stroke="url(#ribbon-right)"
      stroke-width="58"
      stroke-linecap="round"
    />
    <path
      id="ribbon-path"
      class="hero__ribbon-stroke"
      d="M380 60c-90 36-150 96-138 168 14 82 118 98 96 188-16 64-96 108-180 132"
      stroke="url(#ribbon-right)"
      stroke-width="42"
      stroke-linecap="round"
    />
    <text class="hero__path-text">
      <textPath href="#ribbon-path" xlink:href="#ribbon-path" startOffset="0%">
        human judgment · AI speed · products for people · human judgment · AI speed · products for people ·
        <animate
          attributeName="startOffset"
          values="0%;-50%"
          dur="28s"
          repeatCount="indefinite"
        />
      </textPath>
    </text>
    <defs>
      <linearGradient id="ribbon-right" x1="380" y1="40" x2="80" y2="520" gradientUnits="userSpaceOnUse">
        <stop style="stop-color: var(--blue)" />
        <stop offset="0.5" style="stop-color: var(--teal)" />
        <stop offset="1" style="stop-color: var(--olive)" />
      </linearGradient>
    </defs>
  </svg>

  <div class="hero__inner container">
    <div class="hero__stage">
      <p class="kicker hero__kicker" data-rise style="--i: 0">{hero.kicker}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-lead" data-rise style="--i: 1">{hero.titleLead}</span>
        <span class="hero__accent" data-rise style="--i: 2">{hero.titleAccent}</span>
      </h1>
      <p class="lede hero__text" data-rise style="--i: 3">{hero.text}</p>

      <div class="hero__actions" data-rise style="--i: 4">
        <button class="btn btn--solid" type="button" data-calendly-open>
          {hero.primary.label}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
        <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>

      <ul class="hero__chips" aria-label="Live products" data-rise style="--i: 5">
        <li class="hero__chip hero__chip--blue">
          <img src={flowstarter.mark} width="18" height="18" alt="" />
          Flowstarter live
        </li>
        <li class="hero__chip hero__chip--olive">
          <img src={ereno.mark} width="18" height="18" alt="" />
          Ereno live
        </li>
        <li class="hero__chip hero__chip--ghost">Client work live</li>
      </ul>
    </div>

    <div class="hero__peek" aria-label="Product previews">
      <a
        class="hero__card hero__card--back"
        href="#ereno"
        style="--peek-delay: 740ms; --float-delay: 2200ms"
      >
        <div class="hero__card-chrome">
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="mono">ereno.flowstarter.dev/app</span>
        </div>
        <img class="theme-shot theme-shot--light" src={ereno.imageLight} width="960" height="720" alt={ereno.imageAlt} loading="eager" decoding="async" />
        <img class="theme-shot theme-shot--dark" src={ereno.imageDark} width="960" height="720" alt={ereno.imageAlt} loading="eager" decoding="async" />
      </a>
      <a
        class="hero__card hero__card--front"
        href="#flowstarter"
        style="--peek-delay: 620ms; --float-delay: 1800ms"
      >
        <div class="hero__card-chrome">
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="mono">flowstarter.net</span>
        </div>
        <img
          class="theme-shot theme-shot--light"
          src={flowstarter.imageLight}
          width="960"
          height="720"
          alt={flowstarter.imageAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="theme-shot theme-shot--dark"
          src={flowstarter.imageDark}
          width="960"
          height="720"
          alt={flowstarter.imageAlt}
          loading="eager"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.hero__path-text animate').forEach((node) => node.remove());
  }
</script>
