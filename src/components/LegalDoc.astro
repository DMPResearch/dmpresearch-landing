---
interface Section {
  title: string;
  paragraphs?: string[];
  bullets?: string[];
}

interface Props {
  kicker: string;
  title: string;
  lead: string;
  updated: string;
  sections: Section[];
}

const { kicker, title, lead, updated, sections } = Astro.props;
---

<section class="legal-hero section" aria-labelledby="legal-title">
  <div class="container legal-hero__inner" data-reveal>
    <p class="kicker">{kicker}</p>
    <h1 id="legal-title">{title}</h1>
    <p class="lede">{lead}</p>
    <p class="mono legal-hero__updated">{updated}</p>
  </div>
</section>

<article class="legal-doc section">
  <div class="container legal-doc__inner">
    {sections.map((section, index) => (
      <section class="legal-doc__block" data-reveal style={`--delay: ${Math.min(index, 6) * 40}ms`}>
        <h2>{section.title}</h2>
        {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets && (
          <ul>
            {section.bullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</article>

<style>
  .legal-hero {
    border-bottom: 1px solid var(--line);
    padding-block: clamp(48px, 8vw, 88px) clamp(36px, 5vw, 64px);
    background:
      radial-gradient(ellipse 45% 40% at 12% 0%, color-mix(in srgb, var(--olive) 12%, transparent), transparent 60%);
  }

  .legal-hero__inner {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
  }

  .legal-hero h1 {
    font-size: clamp(2.2rem, 1.4rem + 2.6vw, 3.4rem);
  }

  .legal-hero__updated {
    color: var(--fg-3);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .legal-doc {
    border-bottom: 1px solid var(--line);
  }

  .legal-doc__inner {
    display: grid;
    gap: clamp(28px, 4vw, 40px);
    max-width: 44rem;
  }

  .legal-doc__block {
    display: grid;
    gap: 12px;
  }

  .legal-doc__block h2 {
    font-size: 1.35rem;
  }

  .legal-doc__block p,
  .legal-doc__block li {
    color: var(--fg-2);
    font-size: var(--t-small);
    line-height: 1.65;
  }

  .legal-doc__block ul {
    display: grid;
    gap: 10px;
    padding-left: 1.1rem;
  }

  .legal-doc__block li::marker {
    color: var(--teal);
  }
</style>
