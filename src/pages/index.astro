---
import Base from '../layouts/Base.astro'

const mission =
  'We build useful products that blend AI with human work, so people stay in control while software does the heavy lifting.'

const products = [
  {
    name: 'Flowstarter',
    href: 'https://flowstarter.net',
    urlLabel: 'flowstarter.net',
    category: 'Concierge websites',
    className: 'case-card--flow',
    mark: '/flowstarter.svg',
    copy: 'Premium sites for service businesses, with a constrained AI editor so clients keep their site current themselves.',
  },
  {
    name: 'Ereno',
    href: 'https://ereno.flowstarter.dev',
    urlLabel: 'ereno.flowstarter.dev',
    category: 'Travel companion',
    className: 'case-card--ereno',
    mark: '/ereno.svg',
    copy: 'Trip planning and base scouting in one decision session. Evidence, trade-offs, and uncertainty stay visible.',
  },
] as const

const principles = [
  {
    title: 'Useful first',
    body: 'Ship tools people finish work with, not demos that impress once.',
  },
  {
    title: 'Human in the loop',
    body: 'AI proposes. Provenance stays visible. Final calls stay human.',
  },
  {
    title: 'Honest surfaces',
    body: 'No fake certainty. Constraints, sources, and limits stay in the open.',
  },
] as const

function titleWords(text: string, accent = false) {
  return text.split(' ').filter(Boolean).map((word) => ({ word, accent }))
}

let wordIndex = 0
const titleLines = [
  [...titleWords('Two products.'), ...titleWords('One idea.', true)],
]
---

<Base title="DMPResearch" description={mission}>
  <div class="noise" aria-hidden="true"></div>

  <div class="intro-overlay" aria-hidden="true">
    <p class="intro-overlay__text">DMPResearch</p>
  </div>

  <div class="shell">
    <header class="top container">
      <a class="brand" href="/">
        <img src="/mark.svg" width="36" height="36" alt="" />
        <span>DMPResearch</span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a href="#products">Products</a>
        <a href="#approach">Approach</a>
        <a href="https://github.com/DMPResearch" rel="noopener noreferrer">GitHub</a>
        <a class="nav-cta" href="https://flowstarter.net" rel="noopener noreferrer"
          >Built by Flowstarter</a
        >
      </nav>
    </header>

    <main>
      <section class="hero container">
        <div class="hero__grid">
          <div>
            <a class="built-by" href="https://flowstarter.net" rel="noopener noreferrer">
              <img src="/flowstarter.svg" width="22" height="22" alt="" />
              <span>Built by Flowstarter</span>
            </a>
            <h1>
              <span class="brand-word">DMPResearch</span>
            </h1>
            <p class="lede">
              We build useful products that blend
              <span class="lede-accent">AI with human work</span>, so people stay in control while
              software does the heavy lifting.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#products">
                Explore products
                <span aria-hidden="true">↘</span>
              </a>
              <a class="btn btn-ghost" href="https://flowstarter.net" rel="noopener noreferrer"
                >Visit Flowstarter</a
              >
              <a class="btn btn-ghost" href="https://ereno.flowstarter.dev" rel="noopener noreferrer"
                >Visit Ereno</a
              >
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="hero-visual__orb"></div>
            <div class="hero-visual__card">
              <strong>Studio site, shipped as a Flowstarter build</strong>
              <p>Clear structure. Honest copy. Product links up front.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--light" id="products">
        <div class="container">
          <p class="section-label" data-reveal>Products</p>
          <h2 class="word-title">
            {
              titleLines.map((line) => (
                <span class="word-title__line">
                  {line.map(({ word, accent }) => {
                    const delay = wordIndex * 70
                    wordIndex += 1
                    return (
                      <span
                        class:list={['word-title__word', accent && 'word-title__word--accent']}
                        style={`--word-delay:${delay}ms;`}
                      >
                        {word}
                      </span>
                    )
                  })}
                </span>
              ))
            }
          </h2>
          <p class="section-lead" data-reveal>
            AI does the research and drafting. People keep the judgment and the last mile. Open either
            product below.
          </p>

          <div class="product-grid">
            {
              products.map((product) => (
                <a
                  class:list={['case-card', product.className]}
                  href={product.href}
                  rel="noopener noreferrer"
                  data-reveal
                >
                  <div class="case-card__media">
                    <div class="case-card__media-bg"></div>
                    <img class="case-card__mark" src={product.mark} width="64" height="64" alt="" />
                  </div>
                  <div class="case-card__body">
                    <div class="case-card__title-row">
                      <h3 class="case-card__title">{product.name}</h3>
                      <span class="case-card__arrow" aria-hidden="true">
                        ↗
                      </span>
                    </div>
                    <span class="case-card__category">{product.category}</span>
                    <p class="case-card__copy">{product.copy}</p>
                    <span class="case-card__url">{product.urlLabel}</span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section--ink" id="approach">
        <div class="container approach-grid">
          <div data-reveal>
            <p class="section-label">Approach</p>
            <h2 class="word-title" style="font-size: clamp(2rem, 4vw, 2.8rem);">
              <span class="word-title__line">
                {
                  ['How', 'we', 'work'].map((word, i) => (
                    <span class="word-title__word" style={`--word-delay:${i * 70}ms;`}>
                      {word}
                    </span>
                  ))
                }
              </span>
            </h2>
            <p class="section-lead">
              Software should amplify judgment, not replace it. Every product we ship keeps a clear
              handoff: models draft and retrieve, people decide and act.
            </p>
          </div>

          <div class="principles" data-reveal>
            {
              principles.map((item, index) => (
                <details class="principle" open={index === 0}>
                  <summary>
                    <span>
                      {String(index + 1).padStart(2, '0')} · {item.title}
                    </span>
                  </summary>
                  <p>{item.body}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="foot container">
      <div class="foot-brand">
        <img src="/mark.svg" width="28" height="28" alt="" />
        <span>DMPResearch</span>
      </div>
      <p>{mission}</p>
      <div class="foot-links">
        <a href="https://flowstarter.net" rel="noopener noreferrer">Flowstarter</a>
        <a href="https://ereno.flowstarter.dev" rel="noopener noreferrer">Ereno</a>
        <a href="https://github.com/DMPResearch" rel="noopener noreferrer">GitHub</a>
      </div>
      <a class="built-with" href="https://flowstarter.net" rel="noopener noreferrer">
        <img src="/flowstarter.svg" width="18" height="18" alt="" />
        <span>Built with Flowstarter</span>
      </a>
    </footer>
  </div>
</Base>
