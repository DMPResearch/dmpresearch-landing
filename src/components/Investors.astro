---
import { investors } from '../content/site';
---

<section class="investors section" id="investors" aria-labelledby="investors-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="kicker">{investors.kicker}</p>
      <h2 id="investors-title">{investors.title}</h2>
      <p class="lede">{investors.text}</p>
    </header>

    <ul class="investors__thesis" data-spotlight-group>
      {investors.thesis.map((item, index) => (
        <li
          class="investors__card card"
          data-reveal
          data-spotlight
          style={`--delay: ${index * 80}ms`}
        >
          <span class="mono">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>

    <div class="investors__panel card" data-reveal data-inview style="--delay: 120ms">
      <div class="investors__copy">
        <p class="kicker">{investors.ask.kicker}</p>
        <h3>{investors.ask.title}</h3>
        <p class="lede">{investors.ask.text}</p>
      </div>
      <div class="investors__actions">
        <a class="btn btn--solid" href={investors.talkCta.href}>
          {investors.talkCta.label}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={investors.teaserCta.href}>{investors.teaserCta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .investors {
    border-bottom: 1px solid var(--line);
  }

  .investors__thesis {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }

  .investors__card {
    display: grid;
    gap: 10px;
    padding: clamp(22px, 3vw, 28px);
  }

  .investors__card h3 {
    font-size: 1.25rem;
  }

  .investors__card p {
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  .investors__panel {
    display: grid;
    gap: clamp(22px, 3vw, 32px);
    padding: clamp(28px, 4vw, 40px);
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--teal) 10%, transparent), transparent 50%),
      linear-gradient(160deg, var(--card-sheen), transparent 55%),
      var(--card-bg);
    transition: transform 400ms var(--ease), border-color 400ms var(--ease);
  }

  .investors__panel.is-inview {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--teal) 35%, var(--line));
  }

  .investors__panel::after {
    content: '';
    position: absolute;
    inset: auto -20% -40%;
    height: 70%;
    background: var(--grad);
    opacity: 0;
    filter: blur(48px);
    transition: opacity 700ms var(--ease);
    pointer-events: none;
  }

  .investors__panel.is-inview::after {
    opacity: 0.18;
  }

  .investors__copy {
    display: grid;
    gap: var(--s-4);
    max-width: 46rem;
  }

  .investors__copy h3 {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem);
  }

  .investors__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (min-width: 900px) {
    .investors__thesis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
