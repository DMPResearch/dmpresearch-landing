---
import { frontmatter as site } from '../content/site-labels.md';

const { method } = site;
---

<section class="method section" id="method" aria-labelledby="method-title">
  <div class="container">
    <header class="method__head reveal">
      <p class="kicker">
        <b>{method.number}</b>
        <span aria-hidden="true">—</span>
        <span>{method.kicker}</span>
      </p>
      <h2 id="method-title">{method.title}</h2>
      <p class="lede">{method.lede}</p>
    </header>

    <div class="method__loop-wrap reveal">
      <p class="kicker">{method.loopLabel}</p>
      <ol class="method__loop" aria-label="The build loop">
        {method.loop.map((step: string) => (
          <li>{step}</li>
        ))}
      </ol>
    </div>

    <div class="method__split reveal">
      {method.split.map((column: { heading: string; items: string[] }) => (
        <div class="method__column">
          <h3 class="method__column-title">{column.heading}</h3>
          <ul class="method__column-list">
            {column.items.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <ol class="method__steps reveal">
      {method.steps.map((step: { number: string; title: string; text: string }) => (
        <li class="method__step">
          <span class="method__step-number">{step.number}</span>
          <h3 class="method__step-title">{step.title}</h3>
          <p class="method__step-text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method {
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
  }

  .method__head {
    display: grid;
    gap: var(--s-5);
    max-width: 820px;
    margin-bottom: var(--s-8);
  }

  /* The loop */
  .method__loop-wrap {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-8);
  }

  .method__loop {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .method__loop li {
    position: relative;
    padding: var(--s-5);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 48;
  }

  .method__loop li + li {
    border-top: 1px solid var(--rule-strong);
  }

  .method__loop li::after {
    content: '↓';
    position: absolute;
    right: var(--s-5);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--ink-3);
  }

  .method__loop li:last-child::after {
    content: '↺';
  }

  /* Split table */
  .method__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }

  .method__column-title {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--ink);
  }

  .method__column-list li {
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .method__column:last-child .method__column-list li {
    color: var(--ink);
    font-weight: 500;
  }

  /* Steps */
  .method__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  .method__step {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink);
  }

  .method__step-number {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-3);
  }

  .method__step-title {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
  }

  .method__step-text {
    color: var(--ink-2);
    max-width: 40ch;
  }

  @media (min-width: 700px) {
    .method__loop {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .method__loop li + li {
      border-top: 0;
      border-left: 1px solid var(--rule-strong);
    }

    .method__loop li::after {
      content: '→';
      right: -0.55em;
      top: 50%;
      background: var(--paper);
      padding: 2px;
      z-index: 1;
    }

    .method__loop li:last-child::after {
      content: '↺';
      right: var(--s-4);
      background: transparent;
    }

    .method__split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-7);
    }

    .method__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-6);
    }
  }
</style>
