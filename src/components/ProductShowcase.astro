---
interface Spec {
  term: string;
  detail: string;
}

interface Props {
  id: string;
  number: string;
  name: string;
  tagline: string;
  description: string;
  accent: 'blue' | 'olive';
  markSrc: string;
  imageSrc: string;
  imageAlt: string;
  captureLabel: string;
  href: string;
  hrefLabel: string;
  specs: Spec[];
  points: string[];
  flip?: boolean;
  eager?: boolean;
}

const {
  id,
  number,
  name,
  tagline,
  description,
  accent,
  markSrc,
  imageSrc,
  imageAlt,
  captureLabel,
  href,
  hrefLabel,
  specs,
  points,
  flip = false,
  eager = false,
} = Astro.props;
---

<section
  class:list={['product', 'section', `product--${accent}`, { 'product--flip': flip }]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="product__inner container">
    <div class="product__copy reveal">
      <p class="kicker">
        <b>{number}</b>
        <span aria-hidden="true">—</span>
        <span>Product</span>
      </p>

      <div class="product__name">
        <img src={markSrc} width="44" height="44" alt="" />
        <h2 id={`${id}-title`}>{name}</h2>
      </div>

      <p class="product__tagline">{tagline}</p>
      <p class="prose">{description}</p>

      <dl class="product__specs">
        {specs.map((spec) => (
          <div class="product__spec">
            <dt>{spec.term}</dt>
            <dd>{spec.detail}</dd>
          </div>
        ))}
      </dl>

      <ul class="product__points">
        {points.map((point) => <li>{point}</li>)}
      </ul>

      <a class="btn btn--ghost product__cta" href={href} target="_blank" rel="noopener">
        {hrefLabel}
        <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <figure class="product__figure reveal">
      <div class="product__frame">
        <figcaption class="product__caption">
          <span class="product__caption-dot" aria-hidden="true"></span>
          <span>{captureLabel}</span>
          <span class="product__caption-note">Live</span>
        </figcaption>
        <a class="product__shot-link" href={href} target="_blank" rel="noopener" aria-label={`Open ${name} in a new tab`}>
          <img
            class="product__shot"
            src={imageSrc}
            alt={imageAlt}
            width="1288"
            height="1120"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
          />
        </a>
      </div>
    </figure>
  </div>
</section>

<style>
  .product {
    --accent: var(--blue);
    --accent-ink: var(--blue-ink);
    border-top: 1px solid var(--rule);
  }

  .product--olive {
    --accent: var(--olive);
    --accent-ink: var(--olive-ink);
  }

  .product__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-7);
    align-items: start;
  }

  .product__copy {
    display: grid;
    gap: var(--s-5);
  }

  .product__name {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .product__name img {
    flex: none;
    border-radius: 10px;
  }

  .product__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--t-h3);
    line-height: 1.15;
    color: var(--accent-ink);
    font-variation-settings: 'opsz' 48;
    text-wrap: balance;
  }

  .product__specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .product__spec {
    padding: var(--s-3) 0;
    display: grid;
    gap: var(--s-1);
  }

  .product__spec + .product__spec {
    padding-left: var(--s-4);
    border-left: 1px solid var(--rule);
  }

  .product__spec dt {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .product__spec dd {
    font-size: var(--t-small);
    font-weight: 500;
  }

  .product__points {
    display: grid;
    gap: var(--s-3);
  }

  .product__points li {
    position: relative;
    padding-left: var(--s-5);
    color: var(--ink-2);
  }

  .product__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 12px;
    height: 2px;
    background: var(--accent);
  }

  .product__cta {
    justify-self: start;
  }

  /* Screenshot plate */
  .product__figure {
    margin: 0;
  }

  .product__frame {
    background: #fff;
    border: 1px solid var(--ink);
    box-shadow: 10px 10px 0 var(--accent);
    overflow: hidden;
    margin-right: 10px;
    margin-bottom: 10px;
  }

  .product__caption {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 10px 14px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    background: var(--paper);
  }

  .product__caption-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .product__caption-note {
    margin-left: auto;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
  }

  .product__shot-link {
    display: block;
  }

  .product__shot-link:focus-visible {
    outline-offset: -3px;
  }

  .product__shot {
    width: 100%;
    aspect-ratio: 1288 / 1120;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 560px) {
    .product__specs {
      grid-template-columns: 1fr;
    }

    .product__spec + .product__spec {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  @media (min-width: 960px) {
    .product__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(48px, 6vw, 96px);
    }

    .product__copy {
      position: sticky;
      top: 96px;
    }

    .product--flip .product__copy {
      order: 2;
    }

    .product--flip .product__figure {
      order: 1;
    }
  }
</style>
