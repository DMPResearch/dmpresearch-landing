---
import { consentCopy } from '../content/legal';
---

<div class="cookie" data-cookie-root hidden>
  <div
    class="cookie__bar"
    data-cookie-banner
    role="dialog"
    aria-modal="false"
    aria-labelledby="cookie-title"
    aria-describedby="cookie-text"
  >
    <div class="cookie__main">
      <p class="cookie__copy" id="cookie-text">
        <strong id="cookie-title">{consentCopy.title}</strong>
        {'. '}
        {consentCopy.text}
        {' '}
        <a href={consentCopy.privacyLink.href}>{consentCopy.privacyLink.label}</a>
        {' · '}
        <a href={consentCopy.cookiesLink.href}>{consentCopy.cookiesLink.label}</a>
      </p>
      <div class="cookie__actions" data-cookie-simple-actions>
        <button class="cookie__link-btn" type="button" data-cookie-customize>
          {consentCopy.customize}
        </button>
        <button class="btn btn--ghost cookie__btn" type="button" data-cookie-reject>
          {consentCopy.reject}
        </button>
        <button class="btn btn--solid cookie__btn" type="button" data-cookie-accept>
          {consentCopy.acceptAll}
        </button>
      </div>
    </div>

    <div class="cookie__prefs" data-cookie-panel hidden>
      <label class="cookie__option">
        <span class="cookie__option-copy">
          <strong>{consentCopy.categories.necessary.title}</strong>
          <span>{consentCopy.categories.necessary.text}</span>
        </span>
        <span class="cookie__switch">
          <input
            class="cookie__switch-input"
            type="checkbox"
            checked
            disabled
            data-cookie-necessary
            aria-label={consentCopy.categories.necessary.title}
          />
          <span class="cookie__switch-ui" aria-hidden="true"></span>
        </span>
      </label>

      <label class="cookie__option">
        <span class="cookie__option-copy">
          <strong>{consentCopy.categories.thirdParty.title}</strong>
          <span>{consentCopy.categories.thirdParty.text}</span>
        </span>
        <span class="cookie__switch">
          <input
            class="cookie__switch-input"
            type="checkbox"
            data-cookie-third-party
            aria-label={consentCopy.categories.thirdParty.title}
          />
          <span class="cookie__switch-ui" aria-hidden="true"></span>
        </span>
      </label>

      <div class="cookie__actions cookie__actions--prefs">
        <button class="cookie__link-btn" type="button" data-cookie-close>
          {consentCopy.close}
        </button>
        <button class="btn btn--ghost cookie__btn" type="button" data-cookie-reject>
          {consentCopy.reject}
        </button>
        <button class="btn btn--solid cookie__btn" type="button" data-cookie-save>
          {consentCopy.save}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'dmpr-consent';
  const VERSION = 1;

  type ConsentState = {
    version: number;
    necessary: true;
    thirdParty: boolean;
    decidedAt: string;
  };

  const root = document.querySelector('[data-cookie-root]') as HTMLElement | null;
  const bar = document.querySelector('[data-cookie-banner]') as HTMLElement | null;
  const prefs = document.querySelector('[data-cookie-panel]') as HTMLElement | null;
  const simpleActions = document.querySelector('[data-cookie-simple-actions]') as HTMLElement | null;
  const thirdPartyInput = document.querySelector(
    '[data-cookie-third-party]',
  ) as HTMLInputElement | null;

  const syncViewportOffset = () => {
    if (!root || !window.visualViewport) return;
    const vv = window.visualViewport;
    const inset = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
    root.style.setProperty('--cookie-vv-inset', `${inset}px`);
  };

  const readConsent = (): ConsentState | null => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as ConsentState;
      if (parsed.version !== VERSION || typeof parsed.thirdParty !== 'boolean') return null;
      return parsed;
    } catch {
      return null;
    }
  };

  const writeConsent = (thirdParty: boolean) => {
    const state: ConsentState = {
      version: VERSION,
      necessary: true,
      thirdParty,
      decidedAt: new Date().toISOString(),
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    window.dispatchEvent(new CustomEvent('dmpr:consent', { detail: state }));
    return state;
  };

  const showRoot = (open: boolean) => {
    if (!root) return;
    root.hidden = !open;
    if (open) syncViewportOffset();
  };

  const setPrefsOpen = (open: boolean) => {
    if (!prefs || !simpleActions || !bar) return;
    prefs.hidden = !open;
    simpleActions.hidden = open;
    bar.classList.toggle('is-customizing', open);
    if (open) {
      const current = readConsent();
      if (thirdPartyInput) thirdPartyInput.checked = Boolean(current?.thirdParty);
    }
  };

  const closeAll = () => {
    setPrefsOpen(false);
    showRoot(false);
  };

  const openSettings = () => {
    showRoot(true);
    setPrefsOpen(true);
  };

  const decide = (thirdParty: boolean) => {
    writeConsent(thirdParty);
    closeAll();
  };

  const existing = readConsent();
  if (!existing) {
    showRoot(true);
    setPrefsOpen(false);
  } else {
    window.dispatchEvent(new CustomEvent('dmpr:consent', { detail: existing }));
  }

  root?.querySelectorAll('[data-cookie-accept]').forEach((el) => {
    el.addEventListener('click', () => decide(true));
  });
  root?.querySelectorAll('[data-cookie-reject]').forEach((el) => {
    el.addEventListener('click', () => decide(false));
  });
  root?.querySelectorAll('[data-cookie-customize]').forEach((el) => {
    el.addEventListener('click', () => setPrefsOpen(true));
  });
  root?.querySelectorAll('[data-cookie-save]').forEach((el) => {
    el.addEventListener('click', () => decide(Boolean(thirdPartyInput?.checked)));
  });
  root?.querySelectorAll('[data-cookie-close]').forEach((el) => {
    el.addEventListener('click', () => {
      if (readConsent()) closeAll();
      else setPrefsOpen(false);
    });
  });

  document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      openSettings();
    });
  });

  syncViewportOffset();
  window.visualViewport?.addEventListener('resize', syncViewportOffset);
  window.visualViewport?.addEventListener('scroll', syncViewportOffset);
  window.addEventListener('resize', syncViewportOffset, { passive: true });

  window.dmprGetConsent = readConsent;
  window.dmprOpenCookieSettings = openSettings;
</script>

<style>
  .cookie[hidden],
  .cookie [hidden] {
    display: none !important;
  }

  .cookie {
    --cookie-vv-inset: 0px;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 120;
    pointer-events: none;
    padding: 12px;
    padding-bottom: calc(
      12px + env(safe-area-inset-bottom, 0px) + var(--cookie-vv-inset)
    );
  }

  .cookie__bar {
    pointer-events: auto;
    width: min(100%, 600px);
    margin-inline: auto;
    display: grid;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg-2) 55%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, #fff 50%, transparent) inset,
      0 12px 28px -16px color-mix(in srgb, var(--fg) 40%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(170%);
    backdrop-filter: blur(20px) saturate(170%);
  }

  .cookie__main {
    display: grid;
    gap: 10px;
  }

  .cookie__bar.is-customizing .cookie__copy {
    display: none;
  }

  .cookie__copy {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .cookie__copy strong {
    color: var(--fg);
    font-weight: 600;
  }

  .cookie__copy a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie__actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }

  .cookie__actions--prefs {
    padding-top: 2px;
  }

  .cookie__btn {
    min-height: 40px;
    padding-inline: 14px;
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .cookie__link-btn {
    min-height: 40px;
    margin-right: auto;
    padding: 0 6px;
    border: 0;
    background: transparent;
    color: var(--fg-2);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }

  .cookie__link-btn:hover {
    color: var(--fg);
  }

  .cookie__prefs {
    display: grid;
    gap: 6px;
  }

  .cookie__option {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 0;
    cursor: pointer;
  }

  .cookie__option:has(.cookie__switch-input:disabled) {
    cursor: default;
  }

  .cookie__option-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em;
    min-width: 0;
  }

  .cookie__option-copy strong {
    font-size: 0.76rem;
  }

  .cookie__option-copy span {
    color: var(--fg-3);
    font-size: 0.68rem;
    line-height: 1.3;
  }

  .cookie__switch {
    position: relative;
    width: 34px;
    height: 18px;
    flex-shrink: 0;
  }

  .cookie__switch-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
  }

  .cookie__switch-input:disabled {
    cursor: default;
  }

  .cookie__switch-ui {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 14%, transparent);
    transition: background 180ms var(--ease);
  }

  .cookie__switch-ui::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--fg) 22%, transparent);
    transition: transform 180ms var(--ease);
  }

  .cookie__switch-input:checked + .cookie__switch-ui {
    background: var(--teal);
  }

  .cookie__switch-input:checked + .cookie__switch-ui::after {
    transform: translateX(16px);
  }

  .cookie__switch-input:focus-visible + .cookie__switch-ui {
    outline: 2px solid color-mix(in srgb, var(--teal) 55%, transparent);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .cookie {
      padding: 16px;
      padding-bottom: calc(
        16px + env(safe-area-inset-bottom, 0px) + var(--cookie-vv-inset)
      );
    }

    .cookie__bar {
      width: min(100%, 680px);
      padding: 16px 18px;
    }

    .cookie__main {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 16px;
    }
  }

  @media (max-width: 400px) {
    .cookie__btn {
      padding-inline: 10px;
      font-size: 0.76rem;
    }

    .cookie__link-btn {
      font-size: 0.76rem;
    }

    .cookie__copy {
      font-size: 0.76rem;
    }
  }
</style>
