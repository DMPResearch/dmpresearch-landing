---
import { contact, cta } from '../content/site';
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="contact__wash" aria-hidden="true"></div>
  <div class="contact__layout container">
    <div class="contact__intro" data-reveal>
      <p class="kicker">Work with us</p>
      <h2 id="contact-title">{cta.title}</h2>
      <p class="lede contact__text">{cta.text}</p>
      <div class="contact__actions">
        <button class="btn btn--solid" type="button" data-calendly-open>
          {contact.bookLabel}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
        <a class="link contact__email" href={contact.href}>{contact.email}</a>
      </div>
      <p class="contact__hint">{cta.bookHint}</p>
    </div>

    <div class="contact__book" data-reveal style="--delay: 80ms">
      <div
        class="calendly-inline-widget contact__calendly"
        data-url={`${contact.calendlyUrl}?hide_gdpr_banner=1&primary_color=1e9862`}
        role="region"
        aria-label={contact.bookLabel}
      ></div>
      <noscript>
        <p>
          <a href={contact.calendlyUrl} target="_blank" rel="noopener noreferrer">
            {contact.bookLabel} on Calendly
          </a>
        </p>
      </noscript>
    </div>

    <div class="contact__write" data-reveal style="--delay: 120ms">
      <div class="contact__write-head">
        <h3>{cta.formTitle}</h3>
        <p>{cta.formText}</p>
      </div>

      <form
        class="contact__form"
        name="contact"
        method="POST"
        action="/?success=1#contact"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="contact__honey" hidden>
          <label>
            Do not fill this out
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <label class="contact__field">
          <span>{cta.fields.name}</span>
          <input type="text" name="name" required autocomplete="name" maxlength="120" />
        </label>

        <label class="contact__field">
          <span>{cta.fields.email}</span>
          <input type="email" name="email" required autocomplete="email" maxlength="160" />
        </label>

        <label class="contact__field">
          <span>{cta.fields.company}</span>
          <input type="text" name="company" autocomplete="organization" maxlength="160" />
        </label>

        <label class="contact__field contact__field--full">
          <span>{cta.fields.message}</span>
          <textarea name="message" required rows="4" maxlength="4000"></textarea>
        </label>

        <button class="btn btn--ghost contact__submit" type="submit">
          {cta.fields.submit}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>

        <p class="contact__success" hidden data-form-success>{cta.formSuccess}</p>
      </form>
    </div>
  </div>
</section>

<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
<script src="https://assets.calendly.com/assets/external/widget.js" async></script>

<script define:vars={{ calendlyUrl: contact.calendlyUrl }}>
  const params = new URLSearchParams(window.location.search);
  if (params.get('success') === '1') {
    const note = document.querySelector('[data-form-success]');
    if (note instanceof HTMLElement) {
      note.hidden = false;
    }
  }

  const openers = document.querySelectorAll('[data-calendly-open]');
  const openCalendly = () => {
    const calendly = window.Calendly;
    if (calendly?.initPopupWidget) {
      calendly.initPopupWidget({ url: calendlyUrl });
      return;
    }
    window.open(calendlyUrl, '_blank', 'noopener,noreferrer');
  };

  openers.forEach((button) => {
    button.addEventListener('click', openCalendly);
  });
</script>

<style>
  .contact {
    position: relative;
    /* Keep overflow visible so sticky-header scroll-margin works. */
    overflow: visible;
  }

  .contact__wash {
    position: absolute;
    left: 50%;
    bottom: -45%;
    width: min(980px, 130vw);
    height: 75%;
    transform: translateX(-50%);
    pointer-events: none;
    background: var(--grad);
    opacity: 0.18;
    filter: blur(110px);
    border-radius: 50%;
    z-index: -1;
  }

  .contact__layout {
    position: relative;
    display: grid;
    gap: clamp(28px, 4vw, 40px);
    align-items: start;
  }

  .contact__intro {
    display: grid;
    gap: var(--s-4);
    max-width: 36rem;
  }

  .contact__intro h2 {
    font-size: clamp(2.2rem, 1.4rem + 2.8vw, 3.4rem);
    max-width: 14ch;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .contact__email {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--fg-2);
    text-transform: none;
    letter-spacing: 0;
  }

  .contact__hint {
    color: var(--fg-3);
    font-size: var(--t-small);
    max-width: 42ch;
  }

  .contact__book {
    min-width: 0;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: var(--shadow-frame);
  }

  .contact__calendly {
    min-width: 320px;
    min-height: 680px;
    height: 680px;
    background: var(--bg-3);
  }

  .contact__write {
    display: grid;
    gap: 18px;
    padding: clamp(22px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-2) 90%, transparent);
  }

  .contact__write-head {
    display: grid;
    gap: 8px;
  }

  .contact__write-head h3 {
    font-size: 1.35rem;
  }

  .contact__write-head p {
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  .contact__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .contact__honey {
    position: absolute;
    left: -9999px;
  }

  .contact__field {
    display: grid;
    gap: 8px;
  }

  .contact__field span {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--fg-2);
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-3);
    color: var(--fg);
    font: inherit;
    resize: vertical;
    scroll-margin-top: calc(var(--header-h) + 28px);
    transition: border-color 160ms var(--ease), box-shadow 160ms var(--ease);
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 22%, transparent);
  }

  .contact__submit {
    justify-self: start;
    margin-top: 4px;
    min-height: 48px;
  }

  .contact__success {
    grid-column: 1 / -1;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--olive) 40%, transparent);
    background: color-mix(in srgb, var(--olive) 12%, transparent);
    color: var(--fg);
    font-size: var(--t-small);
  }

  @media (min-width: 900px) {
    .contact__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .contact__book {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .contact__write {
      grid-column: 1;
    }

    .contact__form {
      grid-template-columns: 1fr 1fr;
    }

    .contact__field--full,
    .contact__submit,
    .contact__success {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 899px) {
    .contact__calendly {
      height: 620px;
    }
  }
</style>
