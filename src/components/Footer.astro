---
import { contact, footer } from '../content/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <a class="footer__brand" href="#top">
      <img src="/mark.svg" width="24" height="24" alt="" />
      <span>DMPResearch</span>
    </a>

    <nav aria-label="Footer">
      <ul class="footer__links">
        {footer.links.map((link) => (
          <li><a class="footer__link" href={link.href} target="_blank" rel="noopener">{link.label}</a></li>
        ))}
        <li><a class="footer__link" href={contact.href}>{contact.email}</a></li>
      </ul>
    </nav>

    <p class="mono footer__copy">
      © {year} DMPResearch ·{' '}
      <a class="footer__built" href={footer.builtWith.href} target="_blank" rel="noopener">
        {footer.builtWith.label}
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
    padding-block: var(--s-6);
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__brand img {
    border-radius: 6px;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
  }

  .footer__link {
    font-size: 0.875rem;
    color: var(--fg-2);
    transition: color 160ms var(--ease);
  }

  .footer__link:hover {
    color: var(--fg);
  }

  .footer__copy {
    flex-basis: 100%;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .footer__built {
    color: var(--teal);
    transition: color 160ms var(--ease);
  }

  .footer__built:hover {
    color: var(--fg);
  }

  @media (min-width: 820px) {
    .footer__copy {
      flex-basis: auto;
    }
  }
</style>
