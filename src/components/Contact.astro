---
import { frontmatter as site } from '../content/site-labels.md';

const { cta, contact } = site;
---

<section class="contact on-ink" id="contact" aria-labelledby="contact-title">
  <div class="rule-grad" aria-hidden="true"></div>
  <div class="contact__inner container section">
    <div class="contact__copy reveal">
      <p class="kicker">
        <b>{cta.number}</b>
        <span aria-hidden="true">—</span>
        <span>{cta.kicker}</span>
      </p>
      <h2 id="contact-title">{cta.title}</h2>
      <p class="lede">{cta.text}</p>
    </div>

    <div class="contact__actions reveal">
      <a class="btn btn--solid contact__btn" href={contact.href}>
        {cta.primaryLabel}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="contact__email link" href={contact.href}>{contact.email}</a>

      <p class="contact__see">
        <span class="kicker">{cta.seeLabel}</span>
        {cta.links.map((link: { label: string; href: string }) => (
          <a class="link contact__see-link" href={link.href} target="_blank" rel="noopener">{link.label}</a>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--on-ink);
    position: relative;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-7);
  }

  .contact__copy {
    display: grid;
    gap: var(--s-5);
    max-width: 760px;
  }

  .contact__actions {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    align-content: end;
  }

  .contact__btn {
    min-height: 60px;
    padding-inline: var(--s-6);
    font-size: 1.0625rem;
  }

  .contact__email {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.4rem);
    letter-spacing: -0.01em;
    text-decoration-color: var(--rule-on-ink);
    font-variation-settings: 'opsz' 48;
  }

  .contact__see {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-on-ink);
    font-family: var(--font-mono);
    font-size: var(--t-small);
  }

  .contact__see-link {
    color: var(--on-ink-2);
    text-decoration-color: var(--rule-on-ink);
  }

  .contact__see-link:hover {
    color: var(--on-ink);
  }

  @media (min-width: 900px) {
    .contact__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: end;
    }
  }
</style>
