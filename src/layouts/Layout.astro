---
import { frontmatter as site } from '../content/site-labels.md';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { siteMeta } = site;
const { title = siteMeta.title, description = siteMeta.description } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL('/mark.png', Astro.site).href : '/mark.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DMPResearch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 200;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: var(--t-small);
    border-radius: 999px;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
    outline-color: var(--ink);
  }
</style>
