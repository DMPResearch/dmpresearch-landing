---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';

const { team } = siteLabels;
const story: string[] = team.story ?? [];
const agentsNote: string = team.agentsNote ?? '';
---

<SectionBlock id="team" className="team" tone="dark">
  <div class="team__inner container">
    <div class="team__intro">
      <p class="section-label team__label">{team.sectionLabel}</p>
      <h2 class="team__title">{team.sectionTitle}</h2>
      <p class="team__text">{team.text}</p>
      {story.length > 0 && (
        <div class="team__story" data-scroll-reveal>
          {story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}
    </div>
    <div class="team__grid">
      {team.members.map((member, index) => (
        <article
          class="team__card"
          style={`--member-accent: ${member.accent ?? 'var(--brand-primary)'}; --reveal-delay: ${index * 110}ms;`}
          data-scroll-reveal
        >
          <div class="team__avatar" aria-hidden="true">{member.name.slice(0, 1)}</div>
          <h3>{member.name}</h3>
          <p class="team__role">{member.role}</p>
          <p class="team__bio">{member.bio}</p>
        </article>
      ))}
      {agentsNote && (
        <p class="team__plus" data-scroll-reveal style="--reveal-delay: 220ms;">
          <span aria-hidden="true">+</span>
          {agentsNote}
        </p>
      )}
    </div>
  </div>
</SectionBlock>

<style>
  :global(.team) {
    background:
      radial-gradient(ellipse 60% 50% at 100% 0%, rgba(58, 91, 255, 0.14), transparent 55%),
      var(--bg-dark);
    color: var(--text-on-dark);
  }

  .team__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .team__label {
    color: var(--text-on-dark-faint);
  }

  .team__title {
    margin: 0 0 18px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .team__text {
    margin: 0;
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: var(--text-on-dark);
  }

  .team__story {
    display: grid;
    gap: 14px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-on-dark);
    max-width: 34rem;
  }

  .team__story p {
    line-height: 1.6;
    color: var(--text-on-dark-muted);
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .team__card {
    position: relative;
    padding: 24px;
    border: 1px solid var(--border-on-dark);
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }

  .team__card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--member-accent);
  }

  .team__avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: var(--member-accent);
    color: #fff;
    font-family: var(--font-title);
    font-weight: var(--fw-semibold);
    font-size: 1.2rem;
  }

  .team__card h3 {
    margin: 0 0 4px;
    font-size: var(--fs-h3);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .team__role {
    margin: 0 0 14px;
    color: var(--member-accent);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .team__bio {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--text-on-dark-muted);
  }

  .team__plus {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 24px;
    border: 1px dashed var(--border-on-dark);
    font-size: var(--fs-small);
    color: var(--text-on-dark-muted);
  }

  .team__plus span {
    font-family: var(--font-title);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--gold);
  }

  @media (max-width: 900px) {
    .team__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 560px) {
    .team__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
