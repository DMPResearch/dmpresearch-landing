---
interface Props {
  number: string;
  title: string;
  description: string;
  className?: string;
  /** Stagger for the scroll reveal, in ms. */
  revealDelay?: number;
}

const { number, title, description, className = '', revealDelay = 0 } = Astro.props;
---

<div
  class={`ds-numbered-feature ${className}`.trim()}
  data-scroll-reveal
  style={revealDelay ? `--reveal-delay: ${revealDelay}ms;` : undefined}
>
  <span class="ds-numbered-feature__number">{number}</span>
  <div class="ds-numbered-feature__content">
    <h3 class="ds-numbered-feature__title">{title}</h3>
    <p class="ds-numbered-feature__desc">{description}</p>
  </div>
</div>

<style>
  /*
    Readable by default. The scroll-driven blur reveal is applied globally via
    [data-scroll-reveal] (see global.css) and needs no hover or focus. The only
    hover effect is a subtle nudge, and only once the item has been revealed.
  */
  .ds-numbered-feature {
    display: flex;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border-on-light);
    align-items: flex-start;
  }

  .ds-numbered-feature__number {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    color: var(--brand-primary);
    min-width: 36px;
    padding-top: 4px;
  }

  .ds-numbered-feature__content {
    flex: 1;
    transform: translateX(0);
    transition: transform 260ms ease;
  }

  /* Nudge only after reveal (or when JS never marked the item). */
  .ds-numbered-feature:not(.is-observing):hover .ds-numbered-feature__content,
  .ds-numbered-feature.is-visible:hover .ds-numbered-feature__content,
  .ds-numbered-feature:not(.is-observing):focus-within .ds-numbered-feature__content,
  .ds-numbered-feature.is-visible:focus-within .ds-numbered-feature__content {
    transform: translateX(6px);
  }

  .ds-numbered-feature__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .ds-numbered-feature__desc {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-dim-72);
  }

  @media (max-width: 768px) {
    .ds-numbered-feature {
      gap: 16px;
      padding: 22px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-numbered-feature__content {
      transition: none;
    }

    .ds-numbered-feature:hover .ds-numbered-feature__content,
    .ds-numbered-feature:focus-within .ds-numbered-feature__content {
      transform: none !important;
    }
  }
</style>
