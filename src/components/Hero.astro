---
import { contact, hero } from '../content/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__orb hero__orb--a" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--b" aria-hidden="true"></div>

  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="kicker" data-rise style="--i: 0">{hero.kicker}</p>
      <h1 id="hero-title" data-rise style="--i: 1">
        {hero.titleLead}
        <span class="hero__accent">{hero.titleAccent}</span>
      </h1>
      <p class="lede hero__text" data-rise style="--i: 2">{hero.text}</p>
      <div class="hero__actions" data-rise style="--i: 3">
        <a class="btn btn--solid" href={hero.primary.href}>
          {hero.primary.label}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>

    <div class="hero__panel" data-rise style="--i: 2">
      <div class="hero__panel-top">
        <span class="mono">Live signal</span>
        <span class="hero__pulse" aria-hidden="true"></span>
      </div>
      <ul class="hero__facts">
        {hero.facts.map((fact) => (
          <li>
            <strong>{fact.value}</strong>
            <span>{fact.label}</span>
          </li>
        ))}
      </ul>
      <div class="rule-grad" aria-hidden="true"></div>
      <p class="hero__panel-note">
        Build the narrow product exceptionally well. Turn repeated success into infrastructure.
      </p>
      <a class="hero__mail link" href={contact.href}>{contact.email}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--line);
    min-height: min(92dvh, 880px);
    display: grid;
    align-items: center;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.55;
  }

  .hero__orb--a {
    width: min(520px, 70vw);
    height: min(520px, 70vw);
    top: -12%;
    right: -8%;
    background: radial-gradient(circle, rgba(91, 108, 255, 0.55), transparent 68%);
    animation: drift 14s ease-in-out infinite alternate;
  }

  .hero__orb--b {
    width: min(420px, 60vw);
    height: min(420px, 60vw);
    bottom: -18%;
    left: -10%;
    background: radial-gradient(circle, rgba(47, 214, 200, 0.35), transparent 68%);
    animation: drift 18s ease-in-out infinite alternate-reverse;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(24px, -18px, 0) scale(1.08);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    padding-block: clamp(56px, 8vw, 100px) clamp(64px, 9vw, 120px);
  }

  .hero__copy {
    display: grid;
    gap: var(--s-5);
    max-width: 720px;
  }

  .hero__accent {
    display: block;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__text {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .hero__panel {
    display: grid;
    gap: var(--s-5);
    padding: clamp(22px, 3vw, 28px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.05), transparent 45%),
      rgba(14, 20, 27, 0.75);
    box-shadow: var(--shadow-frame);
    backdrop-filter: blur(16px);
  }

  .hero__panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hero__pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--olive);
    box-shadow: 0 0 0 0 rgba(182, 209, 42, 0.55);
    animation: pulse 2.2s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(182, 209, 42, 0.5);
    }
    70% {
      box-shadow: 0 0 0 14px rgba(182, 209, 42, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(182, 209, 42, 0);
    }
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .hero__facts li {
    display: grid;
    gap: 4px;
  }

  .hero__facts strong {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.3rem + 1.5vw, 2.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .hero__facts span {
    color: var(--fg-3);
    font-size: 0.85rem;
  }

  .hero__panel-note {
    color: var(--fg-2);
    font-size: var(--t-small);
    line-height: 1.5;
    max-width: 36ch;
  }

  .hero__mail {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
      align-items: end;
    }
  }

  @media (max-width: 640px) {
    .hero__facts {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__orb,
    .hero__pulse {
      animation: none;
    }
  }
</style>
