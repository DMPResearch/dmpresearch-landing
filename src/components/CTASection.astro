---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import ActionButton from './design-system/ActionButton.astro';

const { cta, contact } = siteLabels;
---

<SectionBlock id="contact" className="cta-section" tone="accent" padding="none">
  <div class="cta-section__inner container">
    {cta.label && <p class="cta-section__label">{cta.label}</p>}
    <h2 class="cta-section__heading">{cta.heading}</h2>
    {cta.text && <p class="cta-section__text">{cta.text}</p>}
    <div class="cta-section__actions">
      {cta.actions.map((action, index) => (
        <ActionButton
          href={action.href}
          label={action.label}
          variant={index === 0 ? 'primary' : 'outline'}
          external={action.href.startsWith('http')}
          className={index === 0 ? 'cta-section__btn cta-section__btn--primary' : 'cta-section__btn ds-action-button--outline-light'}
        />
      ))}
    </div>
    {contact?.email && (
      <p class="cta-section__email">
        {cta.emailPrefix} <a href={contact.href}>{contact.email}</a>
      </p>
    )}
  </div>
</SectionBlock>

<style>
  :global(.cta-section) {
    color: #fff;
    background:
      radial-gradient(ellipse 60% 70% at 15% 100%, rgba(30, 152, 98, 0.35), transparent 60%),
      var(--accent);
  }

  .cta-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    padding-top: clamp(72px, 9vw, 112px);
    padding-bottom: clamp(72px, 9vw, 112px);
  }

  .cta-section__label {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .cta-section__heading {
    max-width: 18ch;
    margin: 0;
    font-size: var(--fs-h1);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: #fff;
  }

  .cta-section__text {
    max-width: 36rem;
    margin: 0;
    font-size: var(--fs-h5);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
  }

  .cta-section__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 10px;
  }

  .cta-section__actions :global(.cta-section__btn) {
    min-width: 190px;
  }

  .cta-section__actions :global(.cta-section__btn--primary) {
    background: #fff;
    color: var(--accent);
  }

  .cta-section__actions :global(.cta-section__btn--primary:hover) {
    opacity: 0.92;
  }

  .cta-section__actions :global(.ds-action-button--outline-light) {
    --outline-fill: #fff;
    --outline-hover-text: var(--accent);
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }

  .cta-section__email {
    margin: 6px 0 0;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.8);
  }

  .cta-section__email a {
    color: #fff;
    font-weight: var(--fw-semibold);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    user-select: all;
  }

  @media (max-width: 768px) {
    .cta-section__actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-section__actions :global(.cta-section__btn) {
      width: 100%;
    }
  }
</style>
