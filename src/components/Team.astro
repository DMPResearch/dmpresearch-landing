---
import { team } from '../content/site';
---

<section class="team section" id="team" aria-labelledby="team-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="kicker">{team.kicker}</p>
      <h2 id="team-title">{team.title}</h2>
      <p class="lede">{team.text}</p>
    </header>

    <ul class="team__grid">
      {team.members.map((member, index) => (
        <li class="team__member card card--hover" data-reveal style={`--delay: ${index * 100}ms`}>
          <div class="team__identity">
            <img
              class="team__photo"
              src={member.photo}
              alt={member.photoAlt}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3 class="team__name">{member.name}</h3>
              <p class="mono team__role">{member.role}</p>
            </div>
          </div>
          <p class="team__bio">{member.bio}</p>
        </li>
      ))}
      <li class="team__crew" data-reveal style="--delay: 200ms">
        <p>{team.crew}</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .team {
    border-bottom: 1px solid var(--line);
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  .team__member {
    display: grid;
    gap: var(--s-5);
    padding: clamp(22px, 3vw, 30px);
  }

  .team__identity {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .team__photo {
    width: 84px;
    height: 84px;
    border-radius: 999px;
    object-fit: cover;
    object-position: center top;
    border: 1px solid var(--line-2);
    box-shadow:
      0 0 0 3px var(--photo-ring),
      0 0 28px -8px var(--photo-glow);
    flex-shrink: 0;
  }

  .team__name {
    font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.2rem);
    letter-spacing: -0.04em;
  }

  .team__role {
    margin-top: 4px;
  }

  .team__bio {
    color: var(--fg-2);
    max-width: 42ch;
  }

  .team__crew {
    display: grid;
    align-content: center;
    padding: 20px 22px;
    border: 1px dashed var(--line-2);
    border-radius: var(--radius);
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  @media (min-width: 760px) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .team__crew {
      grid-column: 1 / -1;
    }

    .team__photo {
      width: 96px;
      height: 96px;
    }
  }

  @media (min-width: 1024px) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 5fr)) minmax(0, 3fr);
    }

    .team__crew {
      grid-column: auto;
    }
  }
</style>
