---
import { contact, cta } from '../content/site';
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="contact__wash" aria-hidden="true"></div>
  <div class="contact__inner container" data-reveal>
    <p class="kicker">Work with us</p>
    <h2 id="contact-title">{cta.title}</h2>
    <p class="lede contact__text">{cta.text}</p>
    <div class="contact__actions">
      <a class="btn btn--solid contact__btn" href={contact.href}>
        {contact.label}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="link contact__email" href={contact.href}>{contact.email}</a>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: clip;
    text-align: center;
  }

  .contact__wash {
    position: absolute;
    left: 50%;
    bottom: -45%;
    width: min(980px, 130vw);
    height: 75%;
    transform: translateX(-50%);
    pointer-events: none;
    background: var(--grad);
    opacity: 0.22;
    filter: blur(110px);
    border-radius: 50%;
  }

  .contact__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
  }

  .contact__inner h2 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4rem);
  }

  .contact__text {
    max-width: 52ch;
  }

  .contact__actions {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    margin-top: var(--s-3);
  }

  .contact__btn {
    min-height: 56px;
    padding-inline: var(--s-6);
    font-size: 1rem;
  }

  .contact__email {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--fg-2);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
