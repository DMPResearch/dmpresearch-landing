---
import { contact, cta, investors } from '../content/site';

interface Props {
  variant?: 'default' | 'investors';
}

const { variant = 'default' } = Astro.props;
const copy = variant === 'investors' ? investors.contact : cta;
const formName = variant === 'investors' ? 'investor' : 'contact';
const formAction = variant === 'investors' ? '/investors/?success=1#talk' : '/?success=1#contact';
const emailHref = variant === 'investors' ? contact.investorHref : contact.href;
const sectionId = variant === 'investors' ? 'talk' : 'contact';
const titleId = variant === 'investors' ? 'talk-title' : 'contact-title';
---

<section class="contact section" id={sectionId} aria-labelledby={titleId}>
  <div class="contact__wash" aria-hidden="true"></div>
  <div class="contact__layout container">
    <div class="contact__intro" data-reveal>
      <p class="kicker">{copy.kicker}</p>
      <h2 id={titleId}>{copy.title}</h2>
      <p class="lede contact__text">{copy.text}</p>
      <div class="contact__actions">
        <button class="btn btn--solid" type="button" data-calendly-open>
          {contact.bookLabel}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
        <a class="link contact__email" href={emailHref}>{contact.email}</a>
      </div>
      <p class="contact__hint">{copy.bookHint}</p>
    </div>

    <div class="contact__write" data-reveal style="--delay: 100ms">
      <div class="contact__write-head">
        <h3>{copy.formTitle}</h3>
        <p>{copy.formText}</p>
      </div>

      <form
        class="contact__form"
        name={formName}
        method="POST"
        action={formAction}
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value={formName} />
        <p class="contact__honey" hidden>
          <label>
            {copy.fields.honeypot}
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <label class="contact__field">
          <span>{copy.fields.name}</span>
          <input type="text" name="name" required autocomplete="name" maxlength="120" />
        </label>

        <label class="contact__field">
          <span>{copy.fields.email}</span>
          <input type="email" name="email" required autocomplete="email" maxlength="160" />
        </label>

        <label class="contact__field">
          <span>{copy.fields.company}</span>
          <input type="text" name="company" autocomplete="organization" maxlength="160" />
        </label>

        <label class="contact__field contact__field--full">
          <span>{copy.fields.message}</span>
          <textarea name="message" required rows="4" maxlength="4000"></textarea>
        </label>

        <button class="btn btn--ghost contact__submit" type="submit">
          {copy.fields.submit}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>

        <p class="contact__success" hidden data-form-success>{copy.formSuccess}</p>
      </form>
    </div>
  </div>
</section>

<script>
  const params = new URLSearchParams(window.location.search);
  if (params.get('success') === '1') {
    const note = document.querySelector('[data-form-success]');
    if (note instanceof HTMLElement) {
      note.hidden = false;
    }
  }
</script>

<style>
  .contact {
    position: relative;
    overflow: clip;
  }

  .contact__wash {
    position: absolute;
    left: 50%;
    bottom: -20%;
    width: min(980px, 100%);
    height: 60%;
    transform: translateX(-50%);
    pointer-events: none;
    background: var(--grad);
    opacity: 0.12;
    filter: blur(90px);
    border-radius: 50%;
    z-index: -1;
  }

  .contact__layout {
    position: relative;
    display: grid;
    gap: clamp(28px, 4vw, 40px);
    align-items: start;
  }

  .contact__intro {
    display: grid;
    gap: var(--s-4);
    max-width: 36rem;
  }

  .contact__intro h2 {
    font-size: clamp(2.2rem, 1.4rem + 2.8vw, 3.4rem);
    max-width: 14ch;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .contact__email {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--fg-2);
    text-transform: none;
    letter-spacing: 0;
  }

  .contact__hint {
    color: var(--fg-3);
    font-size: var(--t-small);
    max-width: 42ch;
  }

  .contact__write {
    display: grid;
    gap: 18px;
    padding: clamp(22px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(160deg, var(--card-sheen), transparent 55%),
      var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .contact__write-head {
    display: grid;
    gap: 8px;
  }

  .contact__write-head h3 {
    font-size: 1.35rem;
  }

  .contact__write-head p {
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  .contact__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .contact__honey {
    position: absolute;
    left: -9999px;
  }

  .contact__field {
    display: grid;
    gap: 8px;
  }

  .contact__field span {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--fg-2);
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-3);
    color: var(--fg);
    font: inherit;
    resize: vertical;
    scroll-margin-top: calc(var(--header-h) + 28px);
    transition: border-color 160ms var(--ease), box-shadow 160ms var(--ease);
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 22%, transparent);
  }

  .contact__submit {
    justify-self: start;
    margin-top: 4px;
    min-height: 48px;
  }

  .contact__success {
    grid-column: 1 / -1;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--olive) 40%, transparent);
    background: color-mix(in srgb, var(--olive) 12%, transparent);
    color: var(--fg);
    font-size: var(--t-small);
  }

  @media (min-width: 900px) {
    .contact__layout {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: stretch;
    }

    .contact__form {
      grid-template-columns: 1fr 1fr;
    }

    .contact__field--full,
    .contact__submit,
    .contact__success {
      grid-column: 1 / -1;
    }
  }
</style>
