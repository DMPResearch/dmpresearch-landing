---
import { frontmatter as site } from '../content/site-labels.md';

const { team } = site;
---

<section class="team section" id="team" aria-labelledby="team-title">
  <div class="container">
    <header class="team__head reveal">
      <p class="kicker">
        <b>{team.number}</b>
        <span aria-hidden="true">—</span>
        <span>{team.kicker}</span>
      </p>
      <h2 id="team-title">{team.title}</h2>
      <p class="lede">{team.lede}</p>
    </header>

    <ul class="team__grid reveal">
      {team.members.map((member: { name: string; role: string; bio: string; accent: string }) => (
        <li class:list={['team__card', `team__card--${member.accent}`]}>
          <span class="team__initial" aria-hidden="true">{member.name.charAt(0)}</span>
          <h3 class="team__name">{member.name}</h3>
          <p class="team__role">{member.role}</p>
          <p class="team__bio">{member.bio}</p>
        </li>
      ))}
      <li class="team__card team__card--crew">
        <span class="team__initial team__initial--crew" aria-hidden="true">·</span>
        <h3 class="team__name">{team.crew.name}</h3>
        <p class="team__role">{team.crew.role}</p>
        <p class="team__bio">{team.crew.bio}</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .team {
    border-top: 1px solid var(--rule);
  }

  .team__head {
    display: grid;
    gap: var(--s-5);
    max-width: 820px;
    margin-bottom: var(--s-8);
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  .team__card {
    --accent: var(--ink);
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .team__card--blue {
    --accent: var(--blue);
  }

  .team__card--olive {
    --accent: var(--olive);
  }

  .team__card--crew {
    border-style: dashed;
    border-color: var(--rule-strong);
  }

  .team__initial {
    font-family: var(--font-display);
    font-size: clamp(5rem, 4rem + 5vw, 8rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--accent);
    margin-bottom: var(--s-4);
    font-variation-settings: 'opsz' 72;
  }

  .team__initial--crew {
    color: var(--ink-3);
  }

  .team__name {
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.3rem);
  }

  .team__role {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .team__bio {
    margin-top: var(--s-3);
    color: var(--ink-2);
  }

  @media (min-width: 760px) {
    .team__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }

    .team__card {
      padding: var(--s-6);
    }
  }
</style>
