---
import { meta } from '../content/site';
import { defaultLocale, getChrome } from '../i18n/config';
import Calendly from '../components/Calendly.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Motion from '../components/Motion.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.description } = Astro.props;
const chrome = getChrome(defaultLocale);

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL('/mark.png', Astro.site).href : '/mark.png';
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a0e" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DMPResearch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-latin.woff2" crossorigin />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        var key = 'dmpr-theme';
        var pref = localStorage.getItem(key);
        if (pref !== 'light' && pref !== 'dark' && pref !== 'auto') pref = 'auto';
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolved = pref === 'auto' ? (dark ? 'dark' : 'light') : pref;
        document.documentElement.setAttribute('data-theme', pref);
        document.documentElement.setAttribute('data-resolved', resolved);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', resolved === 'dark' ? '#070a0e' : '#f3f2ed');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{chrome.skipToContent}</a>
    <slot />
    <CookieConsent />
    <Calendly />
    <Motion />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const reveal = (el: Element) => {
          if (el.classList.contains('is-in')) return;
          el.classList.add('is-in');
          io.unobserve(el);
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) reveal(entry.target);
            }
          },
          // Fire while the block is still entering, so the travel finishes
          // around the time it is fully on screen rather than after.
          { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
        );

        targets.forEach((el) => io.observe(el));

        // A jump that clears a whole section in one frame (hash link, scrollbar
        // drag, fling) never reports an intersection, and a reveal that never
        // fires now means invisible content rather than faint content. Anything
        // the reader has already scrolled past gets shown outright.
        let ticking = false;
        let rest = targets;
        const sweep = () => {
          ticking = false;
          // Keeping only what is still hidden means the measuring stops as the
          // page fills in rather than costing a rect read per element per frame.
          rest = rest.filter((el) => {
            if (el.classList.contains('is-in')) return false;
            if (el.getBoundingClientRect().bottom < 0) {
              reveal(el);
              return false;
            }
            return true;
          });
          if (!rest.length) window.removeEventListener('scroll', onScroll);
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(sweep);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        // The reader can scroll before this module runs, so catch up once.
        sweep();
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 200;
    padding: 10px 14px;
    background: var(--fg);
    color: var(--on-solid);
    font-size: var(--t-small);
    border-radius: 999px;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }
</style>
