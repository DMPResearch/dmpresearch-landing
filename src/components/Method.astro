---
import { method } from '../content/site';
---

<section class="method section" id="method" aria-labelledby="method-title">
  <div class="container">
    <header class="method__head" data-reveal>
      <p class="kicker">How we build</p>
      <h2 id="method-title">{method.title}</h2>
      <p class="lede">{method.text}</p>
    </header>

    <div class="method__grid">
      <div class="method__loop" data-reveal>
        <div class="method__loop-wash" aria-hidden="true"></div>
        <p class="mono method__loop-label">The loop</p>
        <ol class="method__loop-list">
          {method.loop.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {step}
            </li>
          ))}
        </ol>
      </div>

      {method.columns.map((column, index) => (
        <div class="method__cell" data-reveal style={`--delay: ${120 + index * 80}ms`}>
          <h3 class="method__cell-title">{column.heading}</h3>
          <ul class="method__list">
            {column.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .method {
    border-bottom: 1px solid var(--line);
  }

  .method__head {
    display: grid;
    gap: var(--s-4);
    max-width: 640px;
    margin-bottom: var(--s-7);
  }

  .method__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  .method__loop {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--bg-2);
    min-height: 340px;
    display: grid;
    align-content: end;
    gap: var(--s-5);
  }

  .method__loop-wash {
    position: absolute;
    inset: -45% -25% auto;
    height: 130%;
    pointer-events: none;
    background: var(--grad);
    opacity: 0.28;
    filter: blur(80px);
  }

  .method__loop-label {
    position: relative;
  }

  .method__loop-list {
    position: relative;
    display: grid;
    gap: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.15rem + 2.2vw, 2.6rem);
    font-weight: 550;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .method__loop-list li {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .method__loop-list span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--fg-3);
  }

  .method__loop-list li:nth-child(even) {
    color: var(--fg-2);
  }

  .method__cell {
    padding: clamp(24px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(14, 20, 27, 0.75);
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .method__cell-title {
    font-size: 1.2rem;
    font-weight: 600;
  }

  .method__list {
    display: grid;
    gap: var(--s-3);
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  .method__list li {
    padding-left: var(--s-4);
    position: relative;
  }

  .method__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 7px;
    height: 1px;
    background: var(--teal);
  }

  @media (min-width: 720px) {
    .method__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .method__loop {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .method__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .method__loop {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
  }
</style>
