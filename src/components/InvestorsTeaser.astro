---
import { investors } from '../content/site';
---

<section class="investors-teaser section" id="investors" aria-labelledby="investors-teaser-title">
  <div class="container">
    <div class="investors-teaser__panel card" data-reveal data-inview>
      <div class="investors-teaser__copy">
        <p class="kicker">{investors.kicker}</p>
        <h2 id="investors-teaser-title">{investors.title}</h2>
        <p class="lede">{investors.summary}</p>
        <ul class="investors-teaser__highlights">
          {investors.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="investors-teaser__actions">
        <a class="btn btn--solid" href={investors.teaserCta.href}>
          {investors.teaserCta.label}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={investors.talkCta.href}>{investors.talkCta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .investors-teaser {
    border-bottom: 1px solid var(--line);
  }

  .investors-teaser__panel {
    display: grid;
    gap: clamp(22px, 3vw, 32px);
    padding: clamp(28px, 4vw, 40px);
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--teal) 6%, transparent), transparent 55%),
      linear-gradient(160deg, var(--card-sheen), transparent 55%),
      var(--card-bg);
    transition: transform 400ms var(--ease), border-color 400ms var(--ease);
  }

  .investors-teaser__panel.is-inview {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--teal) 35%, var(--line));
  }

  .investors-teaser__panel::after {
    content: '';
    position: absolute;
    inset: auto -20% -40%;
    height: 70%;
    background: var(--grad);
    opacity: 0;
    filter: blur(48px);
    transition: opacity 700ms var(--ease);
    pointer-events: none;
  }

  .investors-teaser__panel.is-inview::after {
    opacity: 0.1;
  }

  .investors-teaser__copy {
    display: grid;
    gap: var(--s-4);
    max-width: 46rem;
  }

  .investors-teaser__copy h2 {
    font-size: clamp(2.05rem, 1.3rem + 2.2vw, 2.9rem);
    max-width: 18ch;
  }

  @media (max-width: 820px) {
    .investors-teaser__copy {
      max-width: none;
      width: 100%;
      text-align: left;
      justify-items: stretch;
    }

    .investors-teaser__copy h2 {
      max-width: none;
    }

    .investors-teaser__highlights,
    .investors-teaser__actions {
      justify-content: flex-start;
    }
  }

  .investors-teaser__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .investors-teaser__highlights li {
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    font-size: 0.82rem;
    color: var(--fg-2);
  }

  .investors-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
