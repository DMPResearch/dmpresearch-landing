---
import { team } from '../content/site';
---

<section class="team section" id="team" aria-labelledby="team-title">
  <div class="container">
    <header class="team__head" data-reveal>
      <p class="kicker">The team</p>
      <h2 id="team-title">{team.title}</h2>
      <p class="lede">{team.text}</p>
    </header>

    <ul class="team__grid">
      {team.members.map((member, index) => (
        <li class="team__member" data-reveal style={`--delay: ${index * 100}ms`}>
          <div class="team__identity">
            <img
              class="team__photo"
              src={member.photo}
              alt={member.photoAlt}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3 class="team__name">{member.name}</h3>
              <p class="mono team__role">{member.role}</p>
            </div>
          </div>
          <p class="team__bio">{member.bio}</p>
        </li>
      ))}
    </ul>

    <p class="team__crew" data-reveal>{team.crew}</p>
  </div>
</section>

<style>
  .team {
    border-bottom: 1px solid var(--line);
  }

  .team__head {
    display: grid;
    gap: var(--s-4);
    max-width: 720px;
    margin-bottom: var(--s-8);
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  .team__member {
    display: grid;
    gap: var(--s-5);
    padding: clamp(24px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.04), transparent 50%),
      rgba(14, 20, 27, 0.7);
    transition: border-color 200ms var(--ease), transform 200ms var(--ease);
  }

  .team__member:hover {
    border-color: var(--line-2);
    transform: translateY(-3px);
  }

  .team__identity {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .team__photo {
    width: 88px;
    height: 88px;
    border-radius: 999px;
    object-fit: cover;
    object-position: center top;
    border: 1px solid var(--line-2);
    box-shadow:
      0 0 0 3px rgba(7, 10, 14, 0.65),
      0 0 28px -8px rgba(91, 108, 255, 0.45);
    flex-shrink: 0;
  }

  .team__name {
    font-size: clamp(1.85rem, 1.4rem + 1.4vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .team__role {
    margin-top: 4px;
  }

  .team__bio {
    color: var(--fg-2);
    max-width: 42ch;
  }

  .team__crew {
    margin-top: var(--s-7);
    padding: 20px 22px;
    border: 1px dashed var(--line-2);
    border-radius: var(--radius);
    color: var(--fg-2);
    max-width: 64ch;
  }

  @media (min-width: 760px) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-5);
    }

    .team__photo {
      width: 104px;
      height: 104px;
    }
  }
</style>
