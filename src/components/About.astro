---
import { about } from '../content/site';

interface Props {
  showIntro?: boolean;
}

const { showIntro = true } = Astro.props;
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="container">
    {showIntro && (
      <header class="about__head section-head" data-reveal>
        <p class="kicker">{about.kicker}</p>
        <h2 id="about-title">{about.title}</h2>
        <p class="lede">{about.lead}</p>
      </header>
    )}

    {!showIntro && <h2 id="about-title" class="visually-hidden">{about.title}</h2>}

    <ul class="about__grid" data-spotlight-group>
      {about.story.map((item, index) => (
        <li
          class="about__card card"
          data-reveal
          data-spotlight
          style={`--delay: ${index * 80}ms`}
        >
          <span class="mono">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 45% 40% at 10% 0%, color-mix(in srgb, var(--olive) 12%, transparent), transparent 60%);
  }

  .about__grid {
    display: grid;
    gap: var(--s-4);
  }

  .about__card {
    display: grid;
    gap: 10px;
    padding: clamp(22px, 3vw, 28px);
  }

  .about__card h3 {
    font-size: 1.35rem;
  }

  .about__card p {
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
