---
import { hero, products } from '../content/site';

const [flowstarter, ereno] = products;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <svg class="hero__ribbon hero__ribbon--left" viewBox="0 0 420 520" fill="none" aria-hidden="true">
    <path
      class="hero__ribbon-stroke"
      d="M48 40c72 48 94 118 78 176-18 66-92 92-74 168 14 58 86 96 156 118"
      stroke="url(#ribbon-left)"
      stroke-width="42"
      stroke-linecap="round"
    />
    <defs>
      <linearGradient id="ribbon-left" x1="40" y1="40" x2="280" y2="500" gradientUnits="userSpaceOnUse">
        <stop style="stop-color: var(--olive)" />
        <stop offset="1" style="stop-color: var(--teal)" />
      </linearGradient>
    </defs>
  </svg>

  <svg class="hero__ribbon hero__ribbon--right" viewBox="0 0 460 540" fill="none" aria-hidden="true">
    <path
      id="ribbon-path"
      d="M380 60c-90 36-150 96-138 168 14 82 118 98 96 188-16 64-96 108-180 132"
      stroke="url(#ribbon-right)"
      stroke-width="38"
      stroke-linecap="round"
    />
    <text class="hero__path-text">
      <textPath href="#ribbon-path" xlink:href="#ribbon-path" startOffset="8%">
        agents propose · we decide · it ships · look again ·
      </textPath>
    </text>
    <defs>
      <linearGradient id="ribbon-right" x1="380" y1="40" x2="80" y2="520" gradientUnits="userSpaceOnUse">
        <stop style="stop-color: var(--blue)" />
        <stop offset="1" style="stop-color: var(--teal)" />
      </linearGradient>
    </defs>
  </svg>

  <div class="hero__inner container">
    <div class="hero__stage" data-rise style="--i: 0">
      <p class="kicker hero__kicker">{hero.kicker}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-lead">{hero.titleLead}</span>
        <span class="hero__accent">{hero.titleAccent}</span>
      </h1>
      <p class="lede hero__text">{hero.text}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={hero.primary.href}>
          {hero.primary.label}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>

      <ul class="hero__chips" aria-label="Live products">
        <li class="hero__chip hero__chip--blue">
          <img src={flowstarter.mark} width="18" height="18" alt="" />
          Flowstarter · live
        </li>
        <li class="hero__chip hero__chip--olive">
          <img src={ereno.mark} width="18" height="18" alt="" />
          Ereno · live
        </li>
        <li class="hero__chip hero__chip--ghost">Gretly vision</li>
      </ul>
    </div>

    <div class="hero__peek" data-rise style="--i: 2" aria-label="Product previews">
      <a class="hero__card hero__card--back" href="#ereno">
        <div class="hero__card-chrome">
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="mono">ereno.flowstarter.dev</span>
        </div>
        <img class="theme-shot theme-shot--light" src={ereno.imageLight} width="960" height="720" alt={ereno.imageAlt} loading="eager" decoding="async" />
        <img class="theme-shot theme-shot--dark" src={ereno.imageDark} width="960" height="720" alt={ereno.imageAlt} loading="eager" decoding="async" />
      </a>
      <a class="hero__card hero__card--front" href="#flowstarter">
        <div class="hero__card-chrome">
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="mono">flowstarter.net</span>
        </div>
        <img
          class="theme-shot theme-shot--light"
          src={flowstarter.imageLight}
          width="960"
          height="720"
          alt={flowstarter.imageAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="theme-shot theme-shot--dark"
          src={flowstarter.imageDark}
          width="960"
          height="720"
          alt={flowstarter.imageAlt}
          loading="eager"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--line);
    /* Clear the sticky header so the title is never clipped on the fold. */
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 48px));
  }

  .hero__ribbon {
    position: absolute;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  .hero__ribbon--left {
    width: min(340px, 42vw);
    left: -6%;
    top: calc(var(--header-h) + 4%);
    transform: rotate(-8deg);
  }

  .hero__ribbon--right {
    width: min(380px, 46vw);
    right: -8%;
    top: calc(var(--header-h) + 2%);
    transform: rotate(6deg);
  }

  .hero__path-text {
    fill: var(--path-text);
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    padding-bottom: 0;
  }

  .hero__stage {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-5);
    max-width: 820px;
    margin-inline: auto;
  }

  .hero__title {
    max-width: 14ch;
  }

  .hero__title-lead {
    display: block;
  }

  .hero__accent {
    display: block;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__text {
    max-width: 48ch;
    margin-inline: auto;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: 4px;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--chip-bg);
    backdrop-filter: blur(10px);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--fg-2);
  }

  .hero__chip img {
    border-radius: 5px;
  }

  .hero__chip--blue {
    border-color: color-mix(in srgb, var(--blue) 35%, transparent);
    box-shadow: 0 0 24px -12px color-mix(in srgb, var(--blue) 70%, transparent);
  }

  .hero__chip--olive {
    border-color: color-mix(in srgb, var(--olive) 35%, transparent);
    box-shadow: 0 0 24px -12px color-mix(in srgb, var(--olive) 55%, transparent);
  }

  .hero__chip--ghost {
    color: var(--fg-3);
  }

  .hero__peek {
    position: relative;
    height: clamp(260px, 38vw, 400px);
    margin-inline: auto;
    width: min(100%, 980px);
    /* Soft fade into the next section so the fold feels intentional. */
    mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
  }

  .hero__card {
    position: absolute;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid var(--line-2);
    background: var(--bg-3);
    box-shadow: var(--shadow-frame);
    transition: transform 320ms var(--ease);
  }

  .hero__card:hover {
    transform: translateY(-6px) scale(1.01);
  }

  .hero__card-chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--card-chrome);
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 20%, transparent);
  }

  .hero__dot:nth-child(1) {
    background: #ff5f57;
  }
  .hero__dot:nth-child(2) {
    background: #febc2e;
  }
  .hero__dot:nth-child(3) {
    background: #28c840;
  }

  .hero__card-chrome .mono {
    margin-left: 6px;
    text-transform: none;
    letter-spacing: 0;
  }

  .hero__card .theme-shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  .hero__card--back {
    width: min(72%, 620px);
    right: 0;
    top: 18%;
    transform: rotate(3deg);
    opacity: 0.94;
  }

  .hero__card--front {
    width: min(78%, 680px);
    left: 0;
    top: 0;
    transform: rotate(-2deg);
  }

  .hero__card--back:hover {
    transform: rotate(3deg) translateY(-6px);
  }

  .hero__card--front:hover {
    transform: rotate(-2deg) translateY(-6px);
  }

  @media (max-width: 820px) {
    .hero {
      padding-top: calc(var(--header-h) + 20px);
    }

    .hero__ribbon--left,
    .hero__ribbon--right {
      opacity: 0.28;
      width: min(260px, 58vw);
    }

    .hero__path-text {
      font-size: 12px;
    }

    .hero__peek {
      height: clamp(220px, 52vw, 300px);
      margin-top: 8px;
    }

    .hero__card--back {
      width: 78%;
      top: 20%;
    }

    .hero__card--front {
      width: 88%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__card,
    .hero__card:hover,
    .hero__card--back:hover,
    .hero__card--front:hover {
      transition: none;
      transform: none;
    }

    .hero__card--back,
    .hero__card--front {
      transform: none;
    }
  }
</style>
