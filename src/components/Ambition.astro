---
import { ambition } from '../content/site';
---

<section class="ambition section" id="vision" aria-labelledby="vision-title">
  <div class="container">
    <div class="ambition__layout">
      <header class="ambition__head" data-reveal>
        <p class="kicker">{ambition.kicker}</p>
        <h2 id="vision-title">{ambition.title}</h2>
        <p class="lede">{ambition.text}</p>
        <p class="ambition__cta">
          <button class="btn btn--solid" type="button" data-calendly-open>
            {ambition.cta.label}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </p>
      </header>

      <ul class="ambition__grid" data-spotlight-group>
        {ambition.points.map((item, index) => (
          <li
            class="ambition__card card"
            data-reveal
            data-spotlight
            style={`--delay: ${index * 80}ms`}
          >
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ambition {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 55% 40% at 80% 0%, color-mix(in srgb, var(--blue) 12%, transparent), transparent 60%),
      radial-gradient(ellipse 45% 35% at 10% 100%, color-mix(in srgb, var(--olive) 9%, transparent), transparent 55%);
  }

  .ambition__layout {
    display: grid;
    gap: var(--section-head);
    align-items: start;
  }

  .ambition__head {
    display: grid;
    gap: var(--s-4);
    max-width: 640px;
  }

  .ambition__cta {
    margin-top: var(--s-2);
  }

  .ambition__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  .ambition__card {
    display: grid;
    gap: 10px;
    padding: 22px;
    align-content: start;
  }

  .ambition__card h3 {
    font-size: 1.2rem;
  }

  .ambition__card p {
    color: var(--fg-2);
    font-size: var(--t-small);
  }

  @media (min-width: 800px) and (max-width: 1023px) {
    .ambition__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ambition__layout {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(40px, 6vw, 96px);
    }

    .ambition__head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }

    .ambition__grid {
      gap: clamp(18px, 2vw, 28px);
      padding-block: 8vh 18vh;
    }

    .ambition__card {
      min-height: 160px;
    }
  }
</style>
